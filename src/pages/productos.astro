---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ProductList from "../components/products/ProductList.astro";
import ProcessSteps from "../components/products/ProcessSteps.astro";
import Measures from "../components/products/Measures.astro";
import ContactBand from "../components/ContactBand.astro";
import heroImage from "../assets/img/proyectos-hero.png";
import { heroPreload } from "../lib/hero";

const preload = await heroPreload(heroImage);
---
<BaseLayout
  title="Productos"
  description="Oro, barras de oro y plata extraídos por Nueva Bonanza Mining en la mina Bonanza, Arequipa. Una operación de extracción que entrega su producción a refinerías autorizadas."
  current="productos"
  heroPreload={preload}
>
  <main>
    <PageHero
      eyebrow="NUESTRA PRODUCCIÓN"
      title="PRODUCTOS"
      text="Nos dedicamos a la extracción de minerales de oro y plata en nuestras operaciones mineras en Arequipa. Conoce nuestra producción, las características de los minerales que obtenemos y las etapas de nuestra actividad minera."
      image={heroImage}
    />
    <ProductList />
    <ProcessSteps />
    <Measures />
    <ContactBand />
  </main>
</BaseLayout>
