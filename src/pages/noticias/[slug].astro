---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Icon from "../../components/Icon.astro";
import placeholder from "../../assets/img/news-1.png";
import { getAllPosts, getPostBySlug, toPlainText } from "../../lib/wordpress";

export const getStaticPaths = (async () => {
  const posts = await getAllPosts();
  return posts.map(({ slug }) => ({ params: { slug } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const post = await getPostBySlug(slug);
if (!post) return new Response(null, { status: 404 });

const image = post.image ?? { src: placeholder.src, alt: "", width: placeholder.width, height: placeholder.height };

// El lead sale del extracto. Si WordPress lo generó a partir del contenido
// (sin extracto manual), el lead repetiría el primer párrafo: se omite.
const leadText = post.excerpt.replace(/\s*(\[…\]|…)$/, "");
const showLead = leadText !== "" && !toPlainText(post.content ?? "").startsWith(leadText);

const ogImage = post.image ? new URL(post.image.src, Astro.url).href : undefined;
---
<BaseLayout
  title={post.title}
  description={post.excerpt || undefined}
  current="noticias"
  image={ogImage}
  ogType="article"
>
  <main>
    <article class="post">
      <div class="post__inner">
        <div class="post__top">
          <h1 class="post__title">{post.title}</h1>
          <a class="back" href="/noticias">
            <span class="icon--flip"><Icon name="arrow-right" size={14} /></span>Noticias
          </a>
        </div>
        <div class="post__meta">
          {post.category && <Eyebrow>{post.category}</Eyebrow>}
          <time datetime={post.date}>{post.dateLabel}</time>
        </div>
        <img
          class="post__img"
          src={image.src}
          srcset={image.srcSet}
          sizes="(max-width: 960px) 100vw, 920px"
          width={image.width}
          height={image.height}
          alt={image.alt}
          fetchpriority="high"
          decoding="async"
        />
        <div class="post__body">
          {showLead && <p class="post__lead">{post.excerpt}</p>}
          {/* HTML del editor de WordPress: el CMS debe ser de confianza (Design.md §9.5). */}
          <Fragment set:html={post.content} />
        </div>
      </div>
    </article>
  </main>
</BaseLayout>
<style>
  .post {
    padding: 64px var(--pad-inline) 80px;
    background: #fff;
  }
  .post__inner {
    max-width: 920px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .post__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }
  .post__title {
    font: 700 52px / 1.05 var(--font-display);
    color: var(--nb-ink-800);
    text-transform: uppercase;
  }
  .back {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding: 10px 16px;
    border: 1px solid var(--nb-gold);
    font: 600 12px / 1 var(--font-body);
    letter-spacing: var(--ls-button);
    color: var(--nb-ink-800);
    text-transform: uppercase;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .back:hover {
    background: var(--nb-gold);
    color: #fff;
  }
  .icon--flip {
    display: inline-flex;
    transform: scaleX(-1);
  }
  .post__meta {
    display: flex;
    align-items: center;
    gap: 16px;
    font: 500 14px / 1 var(--font-body);
  }
  .post__meta :global(.eyebrow) {
    text-transform: uppercase;
  }
  .post__meta time {
    color: var(--nb-taupe);
  }
  .post__img {
    width: 100%;
    height: 460px;
    object-fit: cover;
    background: var(--nb-sand);
  }

  /* Cuerpo: el HTML del editor hereda el diseño mediante selectores descendientes. */
  .post__body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    font: 400 18px / 1.65 var(--font-body);
    color: var(--nb-ink-600);
  }
  .post__lead {
    font-size: 22px;
    line-height: 1.5;
    color: var(--nb-ink-800);
  }
  .post__body :global(blockquote) {
    margin: 12px 0;
    padding-top: 20px;
    border-top: 2px solid var(--nb-gold);
    font: 500 28px / 1.3 var(--font-display);
    color: var(--nb-ink-800);
  }
  .post__body :global(blockquote p) {
    margin: 0;
  }
  .post__body :global(blockquote cite) {
    display: block;
    margin-top: 12px;
    font: 500 14px / 1.4 var(--font-body);
    font-style: normal;
    color: var(--nb-taupe);
  }
  .post__body :global(h2) {
    font: 700 32px / 1.1 var(--font-display);
    color: var(--nb-ink-800);
    margin-top: 12px;
  }
  .post__body :global(h3) {
    font: 700 24px / 1.15 var(--font-display);
    color: var(--nb-ink-800);
    margin-top: 8px;
  }
  .post__body :global(ul),
  .post__body :global(ol) {
    padding-left: 1.25em;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .post__body :global(ul) {
    list-style: disc;
  }
  .post__body :global(ol) {
    list-style: decimal;
  }
  .post__body :global(li::marker) {
    color: var(--nb-gold);
  }
  .post__body :global(a) {
    color: var(--nb-gold-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .post__body :global(a:hover) {
    color: var(--nb-gold);
  }
  .post__body :global(figure) {
    margin: 12px 0;
  }
  .post__body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .post__body :global(figcaption) {
    margin-top: 8px;
    font: 500 14px / 1.4 var(--font-body);
    color: var(--nb-taupe);
  }
  .post__body :global(iframe),
  .post__body :global(video) {
    max-width: 100%;
  }

  @media (max-width: 760px) {
    .post {
      padding: 40px 20px 56px;
    }
    .post__inner {
      gap: 24px;
    }
    .post__top {
      flex-direction: column-reverse;
      gap: 16px;
    }
    .post__title {
      font-size: 34px;
    }
    .back {
      margin-top: 0;
      min-height: 44px;
    }
    .post__img {
      height: 240px;
    }
    .post__body {
      font-size: 16px;
    }
    .post__lead {
      font-size: 18px;
    }
    .post__body :global(blockquote) {
      font-size: 22px;
    }
    .post__body :global(h2) {
      font-size: 26px;
    }
    .post__body :global(h3) {
      font-size: 20px;
    }
  }
</style>
