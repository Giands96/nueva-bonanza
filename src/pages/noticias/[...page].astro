---
import type { GetStaticPaths } from "astro";
import PageHero from "../../components/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroImage from "../../assets/img/news-2.png";
import News from "../../components/news/News.astro";
import { getAllPosts } from "../../lib/wordpress";

// /noticias, /noticias/2, /noticias/3… (9 por página, como el diseño).
export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getAllPosts();
  return paginate(posts, { pageSize: 9 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const title = page.currentPage > 1 ? `Noticias - Página ${page.currentPage}` : "Noticias";
---

<BaseLayout title={title} current="noticias">
    <main>
        <PageHero
          eyebrow="NOTICIAS"
          title="NUEVA BONANZA EN LOS MEDIOS"
          text="Conectamos oportunidades con experiencia minera, criterio técnico y una operación responsable."
          image={HeroImage}
          filled={true}
          eyebrowColor="#fff"
          compact>

        </PageHero>
        <News page={page} />
    </main>
</BaseLayout>
