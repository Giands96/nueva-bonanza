---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Company from "../components/about/Company.astro";
import Timeline from "../components/about/Timeline.astro";
import Principles from "../components/about/Principles.astro";
import ContactBand from "../components/ContactBand.astro";
import heroImage from "../assets/img/quienes_somos_hero.webp";
import { heroParagraphs } from "../data/about";
import { heroPreload } from "../lib/hero";

const preload = await heroPreload(heroImage);
---
<BaseLayout
  title="Quiénes somos"
  description="Nueva Bonanza Mining es una empresa minera arequipeña que opera la mina de oro Bonanza con altos estándares de seguridad y gestión ambiental."
  current="quienes-somos"
  heroPreload={preload}
>
  <main>
    <PageHero
      eyebrow="NUESTRA IDENTIDAD"
      eyebrowColor="#fff"
      title="QUIÉNES SOMOS"
      text={heroParagraphs}
      image={heroImage}
      tall
    />
    <Timeline />
    <Principles />
    <Company />
    <ContactBand />
    
  </main>
</BaseLayout>
