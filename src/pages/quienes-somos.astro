---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Company from "../components/about/Company.astro";
import Timeline from "../components/about/Timeline.astro";
import Principles from "../components/about/Principles.astro";
import ContactBand from "../components/ContactBand.astro";
import heroImage from "../assets/img/quienes_somos.webp";
import { heroPreload } from "../lib/hero";

const preload = await heroPreload(heroImage);
---
<BaseLayout
  title="Quiénes somos"
  description="Nueva Bonanza Mining es una empresa minera arequipeña que opera la mina de oro Bonanza con altos estándares de seguridad y gestión ambiental."
  current="quienes-somos"
  heroPreload={preload}
>
  <main>
    <PageHero
      eyebrow="NUESTRA IDENTIDAD"
      eyebrowColor="var(--nb-ink-800)"
      title="QUIÉNES SOMOS"
      text="Somos una empresa minera dedicada a la exploración, extracción y comercialización de minerales de oro y plata en Arequipa. Desarrollamos nuestras operaciones con responsabilidad, priorizando la seguridad de las personas, la eficiencia operativa y el cuidado del medio ambiente."
      image={heroImage}
    />
    <Company />
    <Timeline />
    <Principles />
    <ContactBand />
  </main>
</BaseLayout>
