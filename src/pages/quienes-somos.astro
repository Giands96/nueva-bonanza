---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Company from "../components/about/Company.astro";
import Timeline from "../components/about/Timeline.astro";
import Principles from "../components/about/Principles.astro";
import ContactBand from "../components/ContactBand.astro";
import heroImage from "../assets/img/qs-hero-team.png";
---
<BaseLayout
  title="Quiénes somos"
  description="Nueva Bonanza Mining es una empresa minera arequipeña que opera la mina de oro Bonanza con altos estándares de seguridad y gestión ambiental."
  current="quienes-somos"
>
  <main>
    <PageHero
      eyebrow="NUESTRA IDENTIDAD"
      eyebrowColor="var(--nb-ink-800)"
      title="QUIÉNES SOMOS"
      text="Somos una empresa minera arequipeña. Desde la mina Bonanza trabajamos con altos estándares de seguridad y gestión ambiental, junto a las comunidades de nuestro entorno."
      image={heroImage}
    />
    <Company />
    <Timeline />
    <Principles />
    <ContactBand />
  </main>
</BaseLayout>
