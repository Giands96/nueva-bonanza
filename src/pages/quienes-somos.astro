---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Company from "../components/about/Company.astro";
import Timeline from "../components/about/Timeline.astro";
import Principles from "../components/about/Principles.astro";
import ContactBand from "../components/ContactBand.astro";
import heroImage from "../assets/img/qs-hero-team.png";
---
<BaseLayout title="Quiénes somos" current="quienes-somos">
  <PageHero
    eyebrow="NUESTRA IDENTIDAD"
    title="QUIÉNES SOMOS"
    text="Somos una empresa minera peruana que extrae con responsabilidad. Cada proyecto está diseñado para generar valor sostenible para las comunidades y el medio ambiente."
    image={heroImage}
  />
  <main>
    <Company />
    <Timeline />
    <Principles />
    <ContactBand />
  </main>
</BaseLayout>
