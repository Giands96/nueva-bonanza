---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactBand from "../components/ContactBand.astro";
import HeroHome from "../components/home/HeroHome.astro";
import AboutSplit from "../components/home/AboutSplit.astro";
import ProductsCarousel from "../components/home/ProductsCarousel.astro";
import Team from "../components/home/Team.astro";
import Impact from "../components/home/Impact.astro";
import heroImage from "../assets/img/hero-mine.png";
import { heroPreload } from "../lib/hero";

const preload = await heroPreload(heroImage);
---
<BaseLayout
  title="Mina Bonanza en Arequipa"
  description="Nueva Bonanza Mining es una empresa minera peruana dedicada a la exploración, explotación y comercialización de minerales de oro y plata, con enfoque en la seguridad, la eficiencia operativa y la gestión ambiental."
  current="inicio"
  heroPreload={preload}
>
  <main>
    <HeroHome />
    <AboutSplit />
    <ProductsCarousel />
    <Team />
    <Impact />
    <ContactBand />
  </main>
</BaseLayout>
