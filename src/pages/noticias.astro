---
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroImage from "../assets/img/news-2.png";

---

<BaseLayout title="Noticias" current="noticias">
    <main>
        <PageHero
          eyebrow="NOTICIAS"
          title="NUEVA BONANZA EN LOS MEDIOS"
          text="Conectamos oportunidades con experiencia minera, criterio técnico y una operación responsable."
          image={HeroImage}
          filled={true}
          eyebrowColor="#fff"
          compact>

        </PageHero>
    </main>
</BaseLayout>