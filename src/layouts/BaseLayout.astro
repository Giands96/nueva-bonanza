---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteUrl, socials, contact } from "../data/site";

interface Props {
  title: string;
  description?: string;
  current?: "inicio" | "quienes-somos" | "productos" | "noticias" | "contacto" | "";
  /** URL absoluta de la imagen para Open Graph. */
  image?: string;
  ogType?: "website" | "article";
  /** Token de verificación de Google Search Console (meta google-site-verification). */
  googleVerification?: string;
  /** Preload del LCP (hero): { href, srcset, sizes } generado con heroPreload(). */
  heroPreload?: { href: string; srcset: string; sizes: string };
  /** Suma <meta name="robots" content="noindex"> (p. ej. página 404). */
  noindex?: boolean;
}

const {
  title,
  description = "Empresa minera en Arequipa, Perú. Conectamos oportunidades con experiencia minera, criterio técnico y una operación responsable.",
  current = "",
  image,
  ogType = "website",
  googleVerification,
  heroPreload,
  noindex = false,
} = Astro.props;

const fullTitle = `${title} | Nueva Bonanza Mining`;
// Canonical sin query strings: evita contenido duplicado en /noticias/noticia?slug=…
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = image ?? `${siteUrl}/favicon.svg`;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Nueva Bonanza Mining",
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  contactPoint: {
    "@type": "ContactPoint",
    telephone: contact.phone,
    email: contact.email,
    contactType: "sales",
    areaServed: "PE",
    availableLanguage: "es",
  },
  address: {
    "@type": "PostalAddress",
    streetAddress: contact.address,
    addressLocality: contact.district,
    addressRegion: contact.city,
    addressCountry: "PE",
  },
  sameAs: socials.map((s) => s.href),
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Nueva Bonanza Mining" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <!-- Marca JS activo antes del primer pintado: las animaciones de aparición solo ocultan contenido con JS. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {heroPreload && (
      <link
        rel="preload"
        as="image"
        href={heroPreload.href}
        imagesrcset={heroPreload.srcset}
        imagesizes={heroPreload.sizes}
        fetchpriority="high"
      />
    )}
    <link
      rel="preload"
      href="/fonts/Oswald.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/SpaceGrotesk.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <Header current={current} />
    <slot />
    <Footer />
    <script>
      // Aparición al desplazar: ver [data-reveal] en global.css.
      const targets = document.querySelectorAll("[data-reveal], [data-reveal-stagger]");
      const reveal = (el: Element) => {
        el.classList.add("is-revealed");
        // Al terminar, se quitan los atributos para que el componente recupere sus transiciones.
        setTimeout(() => {
          el.removeAttribute("data-reveal");
          el.removeAttribute("data-reveal-stagger");
          el.classList.remove("is-revealed");
        }, 1600);
      };
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                reveal(entry.target);
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach(reveal);
      }
    </script>
  </body>
</html>
