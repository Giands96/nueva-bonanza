---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteUrl, socials, getContact } from "../data/site";
import { defaultLang, languages, ogLocales } from "../i18n/ui";
import { getAlternates, getLang, getLanguageLinks, useTranslations } from "../i18n/utils";

interface Props {
  title: string;
  description?: string;
  current?: "inicio" | "quienes-somos" | "productos" | "noticias" | "contacto" | "";
  /** URL absoluta de la imagen para Open Graph. */
  image?: string;
  ogType?: "website" | "article";
  /** Token de verificación de Google Search Console (meta google-site-verification). */
  googleVerification?: string;
  /** Preload del LCP (hero): lista generada con heroPreload(). Con imagen mobile son 2 entradas (desktop + mobile, cada una con su `media`). */
  heroPreload?: Array<{ href: string; srcset: string; sizes: string; media?: string }>;
  /** Suma <meta name="robots" content="noindex"> (p. ej. página 404). */
  noindex?: boolean;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const {
  title,
  description = t("meta.description"),
  current = "",
  image,
  ogType = "website",
  googleVerification,
  heroPreload,
  noindex = false,
} = Astro.props;

const fullTitle = `${title} | Nueva Bonanza Mining`;
// Canonical sin query strings: evita contenido duplicado en /noticias/noticia?slug=…
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = image ?? `${siteUrl}/favicon.svg`;
// Versiones de esta página en otros idiomas (vacío si solo existe en uno).
const alternates = getAlternates(Astro.url.pathname).map(({ lang: altLang, path }) => ({
  lang: altLang,
  href: new URL(path, siteUrl).href,
}));
const defaultAlternate = alternates.find((alt) => alt.lang === defaultLang);
// Aviso para visitantes con navegador en inglés: solo en páginas en español.
const showLangBanner = lang === "es";
// Se ejecuta antes del primer pintado para evitar un salto de layout.
const langBannerScript = `try{var l=(navigator.language||(navigator.languages&&navigator.languages[0])||"").toLowerCase();if(l.indexOf("en")===0&&!localStorage.getItem("nb-lang-banner-dismissed"))document.documentElement.classList.add("show-lang-banner")}catch(e){}`;
const englishHref = getLanguageLinks(Astro.url.pathname, lang).find((l) => l.lang === "en")?.href ?? "/en/";

// Teléfono, correo y dirección no cambian de idioma.
const contact = getContact(lang);

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Nueva Bonanza Mining",
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  contactPoint: {
    "@type": "ContactPoint",
    telephone: contact.phone,
    email: contact.email,
    contactType: "sales",
    areaServed: "PE",
    availableLanguage: Object.keys(languages),
  },
  address: {
    "@type": "PostalAddress",
    streetAddress: contact.address,
    addressLocality: contact.district,
    addressRegion: contact.city,
    addressCountry: "PE",
  },
  sameAs: socials.map((s) => s.href),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Nueva Bonanza Mining" />
    <meta property="og:locale" content={ogLocales[lang]} />
    {alternates
      .filter((alt) => alt.lang !== lang)
      .map((alt) => <meta property="og:locale:alternate" content={ogLocales[alt.lang]} />)}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <!-- Marca JS activo antes del primer pintado: las animaciones de aparición solo ocultan contenido con JS. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    {showLangBanner && (
      <script is:inline set:html={langBannerScript} />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {heroPreload?.map((entry) => (
      <link
        rel="preload"
        as="image"
        href={entry.href}
        imagesrcset={entry.srcset}
        imagesizes={entry.sizes}
        media={entry.media}
        fetchpriority="high"
      />
    ))}
    <link
      rel="preload"
      href="/fonts/Oswald.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/SpaceGrotesk.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    {showLangBanner && (
      <div class="lang-banner" lang="en">
        <p>This site is also available in English.</p>
        <a href={englishHref} hreflang="en">View in English →</a>
        <button type="button" aria-label="Close">✕</button>
      </div>
    )}
    <Header current={current} />
    <slot />
    <Footer />
    {showLangBanner && (
      <script>
        // Cerrar el aviso y recordarlo para no volver a mostrarlo.
        document.querySelector(".lang-banner button")?.addEventListener("click", () => {
          try {
            localStorage.setItem("nb-lang-banner-dismissed", "1");
          } catch {}
          document.documentElement.classList.remove("show-lang-banner");
        });
      </script>
    )}
    <script>
      // Aparición al desplazar: ver [data-reveal] en global.css.
      const targets = document.querySelectorAll("[data-reveal], [data-reveal-stagger]");
      const reveal = (el: Element) => {
        el.classList.add("is-revealed");
        // Al terminar, se quitan los atributos para que el componente recupere sus transiciones.
        // 2600ms cubre la duración máxima (1500ms) + el stagger máximo (450ms) + margen.
        setTimeout(() => {
          el.removeAttribute("data-reveal");
          el.removeAttribute("data-reveal-stagger");
          el.classList.remove("is-revealed");
        }, 2600);
      };
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                reveal(entry.target);
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach(reveal);
      }
    </script>
  </body>
</html>
<style>
  /* Aviso de idioma: oculto salvo que el script del <head> marque el <html>. */
  .lang-banner {
    display: none;
  }
  :global(html.show-lang-banner) .lang-banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 9px 48px 9px 16px;
    background: var(--nb-ink-700);
    color: #fff;
    font: 400 14px / 1.4 var(--font-body);
  }
  .lang-banner p {
    margin: 0;
    text-align: left;
    hyphens: none;
  }
  .lang-banner a {
    color: var(--nb-gold);
    font-weight: 500;
    white-space: nowrap;
  }
  .lang-banner a:hover,
  .lang-banner a:focus-visible {
    text-decoration: underline;
  }
  .lang-banner button {
    position: absolute;
    top: 50%;
    right: 14px;
    transform: translateY(-50%);
    min-width: 32px;
    min-height: 32px;
    padding: 0;
    background: transparent;
    border: 0;
    color: #c4c4c4;
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
  }
  .lang-banner button:hover {
    color: #fff;
  }
  @media (max-width: 760px) {
    :global(html.show-lang-banner) .lang-banner {
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 2px 14px;
      font-size: 13px;
    }
  }
</style>
