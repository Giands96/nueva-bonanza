---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactInfo from "../components/contact/ContactInfo.astro";
import ContactForm from "../components/contact/ContactForm.astro";
import heroImage from "../assets/img/contacto.webp";
import { heroPreload } from "../lib/hero";
import { getLang } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const es = {
  title: "Contacto",
  description:
    "Contacte a Nueva Bonanza Mining por proyectos mineros, consultas comerciales o empleo: Av. Manuel Olguín 325, Surco, Lima. Respondemos en 1 a 2 días hábiles.",
  eyebrow: "CONTACTO",
  heroTitle: "TRABAJEMOS JUNTOS",
  heroText:
    "Conectamos oportunidades con experiencia minera, criterio técnico y una operación responsable.",
  sectionLabel: "Formulario de contacto",
};
const copy: Record<Lang, typeof es> = {
  es,
  en: {
    title: "Contact",
    description:
      "Contact Nueva Bonanza Mining about mining projects, business inquiries or jobs: Av. Manuel Olguín 325, Surco, Lima. We reply within 1 to 2 business days.",
    eyebrow: "CONTACT",
    heroTitle: "LET'S WORK TOGETHER",
    heroText:
      "We connect opportunities with mining experience, technical judgment and responsible operations.",
    sectionLabel: "Contact form",
  },
};
const t = copy[lang];

const preload = await heroPreload(heroImage);
---
<BaseLayout
  title={t.title}
  description={t.description}
  current="contacto"
  heroPreload={preload}
>
  <main>
    <PageHero
      eyebrow={t.eyebrow}
      title={t.heroTitle}
      text={t.heroText}
      focus="35% center"
      image={heroImage}
      filled={true}
      eyebrowColor="#fff"
    />
    <section class="cwrap" aria-label={t.sectionLabel}>
      <ContactInfo />
      <ContactForm />
    </section>
  </main>
</BaseLayout>
<style>
  .cwrap {
    display: flex;
    gap: 48px;
    padding: 56px var(--pad-inline) 64px;
    background: #fff;
  }
  @media (max-width: 1100px) {
    .cwrap {
      flex-direction: column;
    }
  }
  @media (max-width: 760px) {
    .cwrap {
      padding: 40px 20px 48px;
      gap: 36px;
      text-align: center;
      justify-content: center;
      align-items: center;
    }
  }
</style>
