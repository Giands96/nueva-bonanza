---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactBand from "../components/ContactBand.astro";
import HeroHome from "../components/home/HeroHome.astro";
import AboutSplit from "../components/home/AboutSplit.astro";
import ProductsCarousel from "../components/home/ProductsCarousel.astro";
import Team from "../components/home/Team.astro";
import Impact from "../components/home/Impact.astro";
import heroImage from "../assets/img/Hero.webp";
import heroImageMobile from "../assets/img/INDEX_HERO_RESPONSIVE.webp";
import { heroPreload } from "../lib/hero";
import { getLang } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const es = {
  title: "Mina Bonanza en Arequipa",
  description:
    "Nueva Bonanza Mining es una empresa minera peruana dedicada a la exploración, explotación y comercialización de minerales de oro y plata, con enfoque en la seguridad, la eficiencia operativa y la gestión ambiental.",
};
const copy: Record<Lang, typeof es> = {
  es,
  en: {
    title: "Bonanza Mine in Arequipa",
    description:
      "Nueva Bonanza Mining is a Peruvian mining company dedicated to the exploration, mining and marketing of gold and silver ores, with a focus on safety, operational efficiency and environmental management.",
  },
};
const t = copy[lang];

const preload = await heroPreload(heroImage, heroImageMobile);
---
<BaseLayout
  title={t.title}
  description={t.description}
  current="inicio"
  heroPreload={preload}
>
  <main>
    <HeroHome />
    <AboutSplit />
    <ProductsCarousel />
    <Team />
    <Impact />
    <ContactBand />
  </main>
</BaseLayout>
