---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Company from "../components/about/Company.astro";
import Timeline from "../components/about/Timeline.astro";
import Principles from "../components/about/Principles.astro";
import ContactBand from "../components/ContactBand.astro";
import heroImage from "../assets/img/quienes_somos_hero.webp";
import { heroPreload } from "../lib/hero";
import { getLang } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const es = {
  title: "Quiénes somos",
  description:
    "Nueva Bonanza Mining es una empresa minera arequipeña que opera la mina de oro Bonanza con altos estándares de seguridad y gestión ambiental.",
  eyebrow: "NUESTRA IDENTIDAD",
  heroTitle: "QUIÉNES SOMOS",
  heroText:
    "Somos una empresa minera dedicada a la exploración, extracción y comercialización de minerales de oro y plata en Arequipa. Desarrollamos nuestras operaciones con responsabilidad, priorizando la seguridad de las personas, la eficiencia operativa y el cuidado del medio ambiente.",
};
const copy: Record<Lang, typeof es> = {
  es,
  en: {
    title: "About us",
    description:
      "Nueva Bonanza Mining is a mining company from Arequipa that operates the Bonanza gold mine with high standards of safety and environmental management.",
    eyebrow: "OUR IDENTITY",
    heroTitle: "ABOUT US",
    heroText:
      "We are a mining company dedicated to the exploration, extraction and marketing of gold and silver ores in Arequipa. We carry out our operations responsibly, prioritizing the safety of people, operational efficiency and care for the environment.",
  },
};
const t = copy[lang];

const preload = await heroPreload(heroImage);
---
<BaseLayout
  title={t.title}
  description={t.description}
  current="quienes-somos"
  heroPreload={preload}
>
  <main>
    <PageHero
      eyebrow={t.eyebrow}
      eyebrowColor="#fff"
      title={t.heroTitle}
      text={t.heroText}
      image={heroImage}
    />
    <Timeline />
    <Principles />
    <Company />
    <ContactBand />
    
  </main>
</BaseLayout>
