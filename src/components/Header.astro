---
import { getNavigation } from "../data/site";
import { getLang, getLanguageLinks, localizePath } from "../i18n/utils";
import { languages, type Lang } from "../i18n/ui";
import logoUrl from "../assets/img/logo-dorado.webp";

interface Props {
  current?: string;
}

const { current = "" } = Astro.props;

const lang = getLang(Astro.currentLocale);
const es = {
  menuOpen: "Abrir menú",
  menuClose: "Cerrar menú",
  mainNav: "Principal",
  langGroup: "Idioma",
};
const copy: Record<Lang, typeof es> = {
  es,
  en: { menuOpen: "Open menu", menuClose: "Close menu", mainNav: "Main", langGroup: "Language" },
};
const t = copy[lang];
const navigation = getNavigation(lang);
const languageLinks = getLanguageLinks(Astro.url.pathname, lang);
---

<header class="header">
  <a
    class="logo"
    href={localizePath("inicio", lang)}
    aria-label="Nueva Bonanza Mining"
    style={`background-image:url(${logoUrl.src})`}></a>
  <button
    class="menu-btn"
    type="button"
    aria-expanded="false"
    aria-controls="main-nav"
    aria-label={t.menuOpen}
    data-label-open={t.menuOpen}
    data-label-close={t.menuClose}
  >
    <span></span><span></span><span></span>
  </button>
  <nav id="main-nav" class="nav" aria-label={t.mainNav}>
    {
      navigation.map((item) => (
        <a
          href={item.href}
          aria-current={current === item.key ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
    <div class="lang" role="group" aria-label={t.langGroup}>
      {
        languageLinks.map((item, index) => (
          <>
            {index > 0 && (
              <span class="lang-sep" aria-hidden="true">
                |
              </span>
            )}
            {item.current ? (
              <span aria-current="true" aria-label={languages[item.lang]}>
                {item.lang.toUpperCase()}
              </span>
            ) : (
              <a
                href={item.href}
                hreflang={item.lang}
                lang={item.lang}
                aria-label={languages[item.lang]}
              >
                {item.lang.toUpperCase()}
              </a>
            )}
          </>
        ))
      }
    </div>
  </nav>
</header>
<script>
  const btn = document.querySelector<HTMLElement>(".menu-btn");
  const nav = document.getElementById("main-nav");
  btn?.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!open));
    // Los textos vienen del servidor (data-*) para respetar el idioma de la página.
    btn.setAttribute(
      "aria-label",
      (!open ? btn.dataset.labelClose : btn.dataset.labelOpen) ?? "",
    );
    nav?.classList.toggle("is-open", !open);
    document.body.style.overflow = !open ? "hidden" : "";
  });

  // Oculta al bajar, muestra al subir (con el menú abierto nunca se oculta).
  const header = document.querySelector(".header");
  let lastY = window.scrollY;
  let ticking = false;
  const onScroll = () => {
    const y = window.scrollY;
    if (!nav?.classList.contains("is-open") && header) {
      header.classList.toggle("is-hidden", y > 120 && y > lastY);
    }
    lastY = y;
    ticking = false;
  };
  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        window.requestAnimationFrame(onScroll);
        ticking = true;
      }
    },
    { passive: true },
  );
</script>
<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    height: 100px;
    padding: 0 var(--pad-inline);
    background: var(--nb-ink-800);
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: transform 300ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .header.is-hidden {
    transform: translateY(-100%);
  }
  .logo {
    display: block;
    width: 160px;
    height: 92px;
    background-position: 50% 50%;
    background-size: contain;
    background-repeat: no-repeat;
  }
  .nav {
    display: flex;
    gap: 34px;
  }
  .nav a {
    font: 500 16px / 1 var(--font-display);
    color: var(--nb-gold);
    text-transform: uppercase;
  }
  .nav a:hover,
  .nav a[aria-current="page"] {
    color: #fff;
  }
  /* Selector de idioma: mismo tipo que los links, separado por una línea fina. */
  .lang {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-left: 20px;
    border-left: 1px solid var(--nb-umber);
    font: 500 16px / 1 var(--font-display);
    color: var(--nb-gold);
    text-transform: uppercase;
  }
  .lang [aria-current="true"] {
    color: #fff;
  }
  .lang .lang-sep {
    color: var(--nb-umber);
  }
  /* Más específico que `.nav a`: los links del selector heredan la tipografía del grupo. */
  .nav .lang a {
    font: inherit;
  }
  .menu-btn {
    display: none;
  }
  @media (max-width: 1100px) {
    .nav {
      gap: 22px;
    }
    .nav a {
      font-size: 14px;
    }
    .lang {
      padding-left: 14px;
      font-size: 14px;
    }
  }
  @media (max-width: 760px) {

    .logo{
      width: 140px;
      height: 62px;
    }

    .header {
      height: 72px;
      padding: 0 20px;
    }
    .menu-btn {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 6px;
      width: 44px;
      height: 44px;
      padding: 10px;
      background: none;
      border: 0;
      cursor: pointer;
      /* Por encima del overlay (hijo posterior del mismo header). */
      position: relative;
      z-index: 10;
    }
    .menu-btn span {
      display: block;
      height: 2px;
      background: var(--nb-gold);
      transition:
        transform 200ms ease,
        opacity 200ms ease;
    }
    .menu-btn[aria-expanded="true"] span:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }
    .menu-btn[aria-expanded="true"] span:nth-child(2) {
      opacity: 0;
    }
    .menu-btn[aria-expanded="true"] span:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
    }
    .nav {
      position: fixed;
      inset: 0;
      z-index: 9;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 8px;
      background: var(--nb-ink-800);
      padding: 96px 32px 48px;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-16px);
      transition:
        opacity 250ms ease,
        transform 300ms cubic-bezier(0.2, 0.7, 0.2, 1),
        visibility 0s 300ms;
    }
    .nav.is-open {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity 300ms ease,
        transform 350ms cubic-bezier(0.2, 0.7, 0.2, 1),
        visibility 0s;
    }
    .nav a {
      padding: 16px 0;
      border-bottom: 1px solid var(--nb-umber);
      font-size: 28px;
      opacity: 0;
      transform: translateY(12px);
      transition:
        opacity 250ms ease,
        transform 300ms cubic-bezier(0.2, 0.7, 0.2, 1),
        color 200ms ease;
    }
    .nav.is-open a {
      opacity: 1;
      transform: none;
    }
    .nav.is-open a:nth-child(1) {
      transition-delay: 80ms;
    }
    .nav.is-open a:nth-child(2) {
      transition-delay: 130ms;
    }
    .nav.is-open a:nth-child(3) {
      transition-delay: 180ms;
    }
    .nav.is-open a:nth-child(4) {
      transition-delay: 230ms;
    }
    .nav.is-open a:nth-child(5) {
      transition-delay: 280ms;
    }
    /* Selector de idioma: última fila del menú, aparece tras el cuarto link. */
    .lang {
      gap: 14px;
      margin-top: 24px;
      padding-left: 0;
      border-left: 0;
      font-size: 18px;
      opacity: 0;
      transform: translateY(12px);
      transition:
        opacity 250ms ease,
        transform 300ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .nav.is-open .lang {
      opacity: 1;
      transform: none;
      transition-delay: 330ms;
    }
    /* Neutraliza las reglas de `.nav a` (padding, borde, opacidad, retardos). */
    .nav .lang a,
    .nav .lang span {
      padding: 8px 0;
    }
    .nav .lang a {
      border-bottom: 0;
      font-size: inherit;
      opacity: 1;
      transform: none;
      transition: color 200ms ease;
    }
    .nav.is-open .lang a:nth-child(n) {
      transition-delay: 0s;
    }
  }
</style>
