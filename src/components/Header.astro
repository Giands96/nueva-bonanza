---
import { navigation } from "../data/site";
import logoUrl from "../assets/logo-nueva-bonanza.png?url";

interface Props {
  current?: string;
}

const { current = "" } = Astro.props;
---
<header class="header">
  <a
    class="logo"
    href="/"
    aria-label="Nueva Bonanza Mining"
    style={`background-image:url(${logoUrl})`}
  ></a>
  <button
    class="menu-btn"
    type="button"
    aria-expanded="false"
    aria-controls="main-nav"
    aria-label="Abrir menú"
  >
    <span></span><span></span><span></span>
  </button>
  <nav id="main-nav" class="nav" aria-label="Principal">
    {
      navigation.map((item) => (
        <a
          href={item.href}
          aria-current={current === item.key ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
<script>
  const btn = document.querySelector(".menu-btn");
  const nav = document.getElementById("main-nav");
  btn?.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!open));
    btn.setAttribute("aria-label", !open ? "Cerrar menú" : "Abrir menú");
    nav?.classList.toggle("is-open", !open);
    document.body.style.overflow = !open ? "hidden" : "";
  });

  // Oculta al bajar, muestra al subir (con el menú abierto nunca se oculta).
  const header = document.querySelector(".header");
  let lastY = window.scrollY;
  let ticking = false;
  const onScroll = () => {
    const y = window.scrollY;
    if (!nav?.classList.contains("is-open") && header) {
      header.classList.toggle("is-hidden", y > 120 && y > lastY);
    }
    lastY = y;
    ticking = false;
  };
  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        window.requestAnimationFrame(onScroll);
        ticking = true;
      }
    },
    { passive: true }
  );
</script>
<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    height: 80px;
    padding: 0 var(--pad-inline);
    background: var(--nb-cream);
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: transform 300ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .header.is-hidden { transform: translateY(-100%); }
  .logo {
    display: block;
    width: 140px;
    height: 62px;
    background-position: 50% 50%;
    background-size: 100% 225%;
    background-repeat: no-repeat;
  }
  .nav { display: flex; gap: 34px; }
  .nav a {
    font: 500 20px / 1 var(--font-display);
    color: var(--nb-ink-700);
    text-transform: uppercase;
  }
  .nav a:hover,
  .nav a[aria-current="page"] { color: var(--nb-gold); }
  .menu-btn { display: none; }
  @media (max-width: 1100px) {
    .nav { gap: 22px; }
    .nav a { font-size: 18px; }
  }
  @media (max-width: 760px) {
    .header { height: 72px; padding: 0 20px; }
    .menu-btn {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 6px;
      width: 44px;
      height: 44px;
      padding: 10px;
      background: none;
      border: 0;
      cursor: pointer;
      /* Por encima del overlay (hijo posterior del mismo header). */
      position: relative;
      z-index: 10;
    }
    .menu-btn span {
      display: block;
      height: 2px;
      background: var(--nb-ink-700);
      transition: transform 200ms ease, opacity 200ms ease;
    }
    .menu-btn[aria-expanded="true"] span:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }
    .menu-btn[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
    .menu-btn[aria-expanded="true"] span:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
    }
    .nav {
      position: fixed;
      inset: 0;
      z-index: 9;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 8px;
      background: var(--nb-cream);
      padding: 96px 32px 48px;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-16px);
      transition: opacity 250ms ease, transform 300ms cubic-bezier(0.2, 0.7, 0.2, 1), visibility 0s 300ms;
    }
    .nav.is-open {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition: opacity 300ms ease, transform 350ms cubic-bezier(0.2, 0.7, 0.2, 1), visibility 0s;
    }
    .nav a {
      padding: 16px 0;
      border-bottom: 1px solid var(--nb-sand);
      font-size: 28px;
      opacity: 0;
      transform: translateY(12px);
      transition: opacity 250ms ease, transform 300ms cubic-bezier(0.2, 0.7, 0.2, 1), color 200ms ease;
    }
    .nav.is-open a { opacity: 1; transform: none; }
    .nav.is-open a:nth-child(1) { transition-delay: 80ms; }
    .nav.is-open a:nth-child(2) { transition-delay: 130ms; }
    .nav.is-open a:nth-child(3) { transition-delay: 180ms; }
    .nav.is-open a:nth-child(4) { transition-delay: 230ms; }
    .nav.is-open a:nth-child(5) { transition-delay: 280ms; }
  }
</style>
