---
import { stats } from "../../data/about";
import statsBg from "../../assets/img/stats-bg.png";
---
<section class="stats" aria-label="Cifras" style={`background-image:url(${statsBg.src})`}>
  <div class="stats__grid">
    {stats.map((s) => (
      <div class="stat">
        <b>{s.value}</b>
        <h2>{s.title}</h2>
        <p>{s.text}</p>
      </div>
    ))}
  </div>
</section>
<style>
  .stats {
    position: relative;
    padding: 48px 24px;
    background-position: center;
    background-size: cover;
  }
  .stats::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, var(--nb-ink-800) 28.85%, rgba(102, 102, 102, 0) 100%);
  }
  .stats__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .stat {
    padding: 48px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-align: center;
  }
  .stat:nth-child(2) {
    border-left: 1px solid var(--nb-stone-2);
    border-right: 1px solid var(--nb-stone-2);
  }
  .stat b {
    font: 700 96px / 1 var(--font-display);
    color: var(--nb-gold);
  }
  .stat h2 {
    font: 700 40px / 1 var(--font-display);
    color: #fff;
  }
  .stat p {
    font-size: 20px;
    line-height: 1.3;
    color: #fff;
  }
  @media (max-width: 1100px) {
    .stat b {
      font-size: 72px;
    }
    .stat h2 {
      font-size: 28px;
    }
    .stat p {
      font-size: 16px;
    }
  }
  @media (max-width: 760px) {
    .stats {
      padding: 32px 20px;
    }
    .stats__grid {
      grid-template-columns: 1fr;
    }
    .stat {
      padding: 32px 16px;
    }
    .stat:nth-child(2) {
      border-left: none;
      border-right: none;
      border-top: 1px solid var(--nb-stone-2);
      border-bottom: 1px solid var(--nb-stone-2);
    }
    .stat b {
      font-size: 72px;
    }
    .stat h2 {
      font-size: 32px;
    }
    .stat p {
      font-size: 16px;
    }
  }
</style>
