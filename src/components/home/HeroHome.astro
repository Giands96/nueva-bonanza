---
import Button from "../Button.astro";
import heroMine from "../../assets/img/hero-mine.png";
---
<section class="hero" style={`background-image:url(${heroMine.src})`}>
  <div class="hero__content">
    <h1 class="hero__title">EL FUTURO SE{" "}<span>EXTRAE HOY</span></h1>
    <Button variant="outline" href="/proyectos">Conoce nuestros proyectos</Button>
  </div>
</section>
<style>
  .hero {
    position: relative;
    height: 663px;
    background-position: center;
    background-size: cover;
    display: flex;
    align-items: center;
    padding: 0 48px;
    overflow: hidden;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.35) 45%, rgba(0, 0, 0, 0) 70%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.34), rgba(0, 0, 0, 0) 40%);
  }
  .hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    color: #fff;
    animation: hero-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero__title {
    font: 600 28px / 1 var(--font-display);
    letter-spacing: 0.02em;
  }
  .hero__title span {
    display: block;
    margin-top: 8px;
    font-size: 112px;
    font-weight: 700;
  }
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(28px); }
    to { opacity: 1; transform: none; }
  }
  @media (max-width: 1100px) {
    .hero__title span { font-size: 84px; }
  }
  @media (max-width: 760px) {
    .hero {
      height: 650px;
      padding: 0 20px;
      align-items: flex-end;
      padding-bottom: 64px;
    }
    .hero::before {
      background: linear-gradient(0deg, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.4) 55%, rgba(0, 0, 0, 0.15) 100%);
    }
    .hero__title { font-size: 22px; }
    .hero__title span { font-size: 68px; margin-top: 6px; }
  }
</style>
