---
import { Image } from "astro:assets";
import Eyebrow from "../Eyebrow.astro";
import PolicyAccordion from "./PolicyAccordion.astro";
import { getPolicies } from "../../data/about";
import operatorCabin from "../../assets/img/index_quienes_somos.webp";
import { getLang } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";

const lang = getLang(Astro.currentLocale);
const es = {
  label: "Quiénes somos",
  eyebrow: "NUESTRA IDENTIDAD",
  title: "QUIÉNES SOMOS",
  lead: "Somos una empresa minera dedicada a la exploración, explotación y comercialización de oro y plata. Desarrollamos nuestras operaciones con responsabilidad y eficiencia, priorizando la seguridad de las personas, la protección del medio ambiente y la mejora continua. Contribuimos al desarrollo de la industria minera y al crecimiento de la economía peruana.",
  policiesTitle: "POLÍTICAS Y COMPROMISOS",
  photoAlt: "Operador con casco frente a pantallas de control",
};
const copy: Record<Lang, typeof es> = {
  es,
  en: {
    label: "About us",
    eyebrow: "OUR IDENTITY",
    title: "ABOUT US",
    lead: "We are a mining company dedicated to the exploration, mining and marketing of gold and silver. We carry out our operations responsibly and efficiently, prioritizing the safety of people, environmental protection and continuous improvement. We contribute to the development of the mining industry and the growth of the Peruvian economy.",
    policiesTitle: "POLICIES AND COMMITMENTS",
    photoAlt: "Operator in a hard hat in front of control screens",
  },
};
const t = copy[lang];
const policies = getPolicies(lang);
---
<section class="about" aria-label={t.label}>
  <div class="about__text" data-reveal-stagger>
    <span class="about__eyebrow"><Eyebrow>{t.eyebrow}</Eyebrow></span>
    <h2 class="title about__title">{t.title}</h2>
    <p class="about__lead">
      {t.lead}
    </p>
    <h3 class="about__sub">{t.policiesTitle}</h3>
    <PolicyAccordion policies={policies} />
  </div>
  <Image
    class="about__photo"
    data-reveal="image"
    src={operatorCabin}
    alt={t.photoAlt}
    widths={[480, 800, 1200]}
    sizes="(max-width: 1100px) 100vw, 50vw"
    format="webp"
    quality={70}
    loading="lazy"
    decoding="async"
  />
</section>
<style>
  .about {
    display: flex;
    gap: 48px;
    align-items: center;
    padding: 72px var(--pad-inline);
    background: #fff;
  }
  .about__text {
    flex: 0 0 598px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .about__eyebrow { font-weight: 700; }
  .about__title { color: var(--nb-ink-700); }
  .about__lead { font-size: 18px; line-height: 1.55; }
  .about__sub {
    font: 700 20px / 1 var(--font-display);
    color: var(--nb-gold);
  }
  .about__photo {
    flex: 1;
    min-width: 0;
    height: 640px;
    border-radius: var(--radius-image);
    object-fit: cover;
  }
  @media (max-width: 1100px) {
    .about { flex-direction: column; align-items: stretch; }
    .about__text { flex: none; }
    .about__photo { flex: none; height: 440px; }
  }
  @media (max-width: 760px) {
    .about { flex-direction: column; align-items: stretch; gap: 32px; padding: 48px 20px; }
    .about__text { flex: none; }
    .about__lead { font-size: 16px; }
    .about__photo { flex: none; height: 360px; }
  }
</style>
