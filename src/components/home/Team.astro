---
import { Image } from "astro:assets";
import Eyebrow from "../Eyebrow.astro";
import teamPhoto from "../../assets/img/team.png";
---
<section class="team" aria-label="Nuestro equipo">
  <span class="team__eyebrow"><Eyebrow>CONÓCENOS</Eyebrow></span>
  <h2 class="title">NUESTRO EQUIPO</h2>
  <p>
    Profesionales especializados que combinan experiencia, conocimiento técnico
    y compromiso para sostener una minería eficiente y responsable.
  </p>
  <Image
    class="team__photo"
    src={teamPhoto}
    alt="Personal de Nueva Bonanza Mining frente a camiones mineros"
  />
</section>
<style>
  .team {
    padding: 72px var(--pad-inline);
    background: var(--nb-cream);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
  }
  .team .title { color: #000; }
  .team__eyebrow { width: 100%; text-align: center; }
  .team p { font-size: 20px; line-height: 1.4; color: #000; max-width: 760px; }
  .team__photo { width: 100%; height: 416px; object-fit: cover; }
  @media (max-width: 760px) {
    .team { padding: 48px 20px; }
    .team p { font-size: 16px; }
    .team__photo { height: 220px; }
  }
</style>
