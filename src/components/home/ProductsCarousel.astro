---
import Eyebrow from "../Eyebrow.astro";
import ProductCard from "./ProductCard.astro";
import { getProducts } from "../../data/products";
import { getLang } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";

const lang = getLang(Astro.currentLocale);
const es = {
  eyebrow: "NUESTRA PRODUCCIÓN",
  title: "PRODUCTOS",
  text: "Conoce nuestra producción, las características de los minerales que obtenemos y las etapas de nuestra actividad minera.",
  viewProduct: "Ver producto",
};
const copy: Record<Lang, typeof es> = {
  es,
  en: {
    eyebrow: "OUR PRODUCTION",
    title: "PRODUCTS",
    text: "Learn about our production, the characteristics of the minerals we obtain and the stages of our mining activity.",
    viewProduct: "View product",
  },
};
const t = copy[lang];
const featured = getProducts(lang).slice(0, 3);
---

<section class="products" aria-labelledby="products-title">
  <div class="products__head">
    <div class="products__intro" data-reveal-stagger>
      <Eyebrow filled>{t.eyebrow}</Eyebrow>
      <h2 id="products-title" class="title">{t.title}</h2>
      <p id="products_description">
        {t.text}
      </p>
    </div>
  </div>
  <div class="products__track" data-reveal-stagger>
    {featured.map((p) => <ProductCard product={p} />)}
  </div>
  <div class="dots">
    <button type="button" class="is-active" aria-label={`${t.viewProduct} 1`}></button><button
      type="button"
      aria-label={`${t.viewProduct} 2`}
    ></button><button type="button" aria-label={`${t.viewProduct} 3`}></button>
  </div>
</section>
<script>
  // Misma lógica que los botones Atrás/Siguiente: avance discreto de a 1 slide.
  // El swipe táctil solo decide la dirección; el movimiento lo hace goTo().
  const section = document.querySelector(".products");
  const track = section?.querySelector<HTMLElement>(".products__track") ?? null;
  const dots = [...(section?.querySelectorAll<HTMLButtonElement>(".dots button") ?? [])];
  const mq = window.matchMedia("(max-width: 1024px)");
  let current = 0;

  const step = () => {
    const card = track?.querySelector(".product");
    if (!track || !card) return 0;
    const gap = parseFloat(
      getComputedStyle(track).columnGap || getComputedStyle(track).gap || "0",
    );
    return card.clientWidth + (Number.isNaN(gap) ? 0 : gap);
  };
  const goTo = (i: number, smooth = true) => {
    if (!track) return;
    current = Math.max(0, Math.min(dots.length - 1, i));
    track.scrollTo({
      left: current * step(),
      behavior: smooth ? "smooth" : "auto",
    });
    dots.forEach((dot, n) => dot.classList.toggle("is-active", n === current));
  };
  // Dots con la misma lógica de controles
  dots.forEach((dot, n) => dot.addEventListener("click", () => goTo(n)));

  // Sin listener de scroll a propósito: el track es overflow hidden y solo
  // se mueve por goTo(), que ya actualiza los dots de forma sincrónica.
  // Escuchar el scroll durante la animación suave recalculaba el índice
  // con valores intermedios y hacía parpadear los dots.

  // Swipe táctil = Atrás / Siguiente. Umbral fijo, un producto por gesto.
  let startX = 0;
  let startY = 0;
  track?.addEventListener(
    "touchstart",
    (e: TouchEvent) => {
      if (!mq.matches) return;
      const t = e.touches[0];
      if (!t) return;
      startX = t.clientX;
      startY = t.clientY;
    },
    { passive: true },
  );
  track?.addEventListener(
    "touchend",
    (e: TouchEvent) => {
      if (!mq.matches) return;
      const t = e.changedTouches[0];
      if (!t) return;
      const dx = t.clientX - startX;
      const dy = t.clientY - startY;
      // Solo gestos horizontales claros: evita pelear con el scroll vertical
      if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
      goTo(current + (dx < 0 ? 1 : -1));
    },
    { passive: true },
  );

  // Al volver a desktop o rotar, re-clava el slide actual sin animación
  window.addEventListener("resize", () => goTo(current, false));
</script>
<style>
  .products {
    padding: 72px var(--pad-inline) 80px;
    background: var(--nb-ink-800);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .products__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
  }

  #products_description {
    min-width:100%
  }

  .products__intro {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .products__intro .title {
    color: var(--nb-ink-100);
  }
  .products__intro p {
    font-size: 20px;
    line-height: 1.4;
    color: #fff;
  }
  .products__track {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .dots {
    display: none;
  }

  @media (max-width: 1100px) {
    .products__head {
      flex-direction: column;
      align-items: stretch;
    }
  }
  /* Tablet y móvil: un producto por vista, avance discreto como los botones.
     Sin scroll-snap ni corrección por JS: el swipe solo elige dirección. */
  @media (max-width: 1024px) {
    .products__track {
      display: flex;
      gap: 20px;
      overflow-x: hidden;
      overflow-y: hidden;
      scrollbar-width: none;
      -ms-overflow-style: none;
      touch-action: pan-y;
      overscroll-behavior-x: contain;
      padding-bottom: 4px;
    }
    .products__track::-webkit-scrollbar {
      display: none;
    }
    .products__track :global(.product) {
      flex: 0 0 100%;
    }
    .dots {
      display: flex;
      justify-content: center;
      gap: 16px;
    }
    .dots button {
      width: 10px;
      height: 10px;
      padding: 0;
      border: 0;
      border-radius: var(--radius-round);
      background: rgba(255, 255, 255, 0.4);
      cursor: pointer;
    }
    .dots button.is-active {
      background: var(--nb-gold);
    }
  }
  @media (max-width: 760px) {
    .products {
      padding: 48px 20px;
      gap: 28px;
    }
    .products__head {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }
    .products__intro p {
      font-size: 16px;
    }
  }
</style>
