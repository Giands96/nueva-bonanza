---
import Eyebrow from "../Eyebrow.astro";
import Icon from "../Icon.astro";
import ProductCard from "./ProductCard.astro";
import { products } from "../../data/products";

const featured = products.slice(0, 3);
---

<section class="products" aria-labelledby="products-title">
  <div class="products__head">
    <div class="products__intro" data-reveal-stagger>
      <Eyebrow filled>NUESTRA PRODUCCIÓN</Eyebrow>
      <h2 id="products-title" class="title">PRODUCTOS</h2>
      <p>
        Oro, barras de oro y plata extraídos en la mina Bonanza, en Arequipa, con
        altos estándares de seguridad y gestión ambiental.
      </p>
    </div>
    <div class="carousel-ctl">
      <button type="button" data-dir="-1">
        <span class="icon--flip"><Icon name="arrow-back" size={16} /></span
        >Atrás
      </button>
      <button type="button" data-dir="1">
        Siguiente<Icon name="arrow-forward" size={16} />
      </button>
    </div>
  </div>
  <div class="products__track" data-reveal-stagger>
    {featured.map((p) => <ProductCard product={p} />)}
  </div>
  <div class="dots" aria-hidden="true">
    <span class="is-active"></span><span></span><span></span>
  </div>
</section>
<script>
  const track = document.querySelector(".products__track");
  const dots = [...document.querySelectorAll(".dots span")];
  const step = () => track?.querySelector(".product")?.clientWidth ?? 0;
  document.querySelectorAll(".carousel-ctl button").forEach((btn) => {
    btn.addEventListener("click", () => {
      track?.scrollBy({
        left: Number(btn.getAttribute("data-dir")) * step(),
        behavior: "smooth",
      });
    });
  });
  track?.addEventListener(
    "scroll",
    () => {
      const activeIndex = Math.round(track.scrollLeft / step() || 0);
      dots.forEach((dot, n) =>
        
        dot.classList.toggle("is-active", n === activeIndex),
      );
    },
    { passive: true },
  );
</script>
<style>
  .products {
    padding: 72px var(--pad-inline) 80px;
    background: var(--nb-ink-800);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .products__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
  }
  .products__intro {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 759px;
  }
  .products__intro .title {
    color: var(--nb-ink-100);
  }
  .products__intro p {
    font-size: 20px;
    line-height: 1.4;
    color: #fff;
  }
  .carousel-ctl {
    display: flex;
    gap: 24px;
  }
  .carousel-ctl button {
    display: flex;
    align-items: center;
    gap: 10px;
    background: none;
    border: 0;
    padding: 10px;
    font: 600 14px / 1 var(--font-body);
    letter-spacing: var(--ls-caps);
    color: #f8f8f8;
    cursor: pointer;
    text-transform: uppercase;
  }

  .carousel-ctl button:hover {
    color: var(--nb-gold);
  }

  .icon--flip {
    display: inline-flex;
    transform: scaleX(-1);
  }

  .products__track {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .dots {
    display: none;
  }

  @media (max-width: 1100px) {
    .products__head {
      flex-direction: column;
      align-items: stretch;
    }
  }
  @media (max-width: 760px) {
    .products {
      padding: 48px 20px;
      gap: 28px;
    }
    .products__head {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }
    .products__intro p {
      font-size: 16px;
    }
    .carousel-ctl {
      justify-content: space-between;
    }
    .carousel-ctl button {
      padding: 12px 0;
      min-height: 44px;
    }
    .products__track {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .products__track::-webkit-scrollbar {
      display: none;
    }
    .dots {
      display: flex;
      justify-content: center;
      gap: 16px;
    }
    .dots span {
      width: 10px;
      height: 10px;
      border-radius: var(--radius-round);
      background: rgba(255, 255, 255, 0.4);
    }
    
    .dots span.is-active {
      background: var(--nb-gold);
    }
  }
</style>
