---
import type { Product } from "../../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---
<a
  class="product"
  href={`/productos#${product.id}`}
  style={`background-image:url(${product.image.src})`}
>
  <span class="product__region">{product.label}</span>
  <span class="product__name">{product.name}</span>
  <span class="product__desc"><span>{product.summary}</span></span>
</a>
<style>
  .product {
    position: relative;
    height: 480px;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    filter: grayscale(1);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    padding: 32px;
    color: #fff;
    transition: filter 300ms ease;
  }
  .product:hover { filter: grayscale(0); }
  .product::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.57) 62.98%);
  }
  .product > * { position: relative; }
  .product__desc {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 450ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .product__desc > span {
    min-height: 0;
    overflow: hidden;
    padding-top: 0;
    font: 400 16px / 1.5 var(--font-body);
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 450ms ease, transform 450ms cubic-bezier(0.2, 0.7, 0.2, 1), padding-top 450ms ease;
  }
  .product:hover .product__desc,
  .product:focus-visible .product__desc { grid-template-rows: 1fr; }
  .product:hover .product__desc > span,
  .product:focus-visible .product__desc > span { opacity: 1; transform: none; padding-top: 12px; }
  @media (hover: none) {
    .product__desc { grid-template-rows: 1fr; }
    .product__desc > span { opacity: 1; transform: none; padding-top: 12px; }
  }
  .product__region {
    font: 600 16px / 1 var(--font-body);
    letter-spacing: var(--ls-caps);
  }
  .product__name { font: 700 40px / 1 var(--font-display); }
  @media (max-width: 760px) {
    .product {
      flex: 0 0 100%;
      height: 420px;
      scroll-snap-align: start;
      padding: 24px;
    }
    .product__name { font-size: 36px; }
  }
</style>
