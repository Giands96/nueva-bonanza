---
import Eyebrow from "../Eyebrow.astro";
import { getLang } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";

const lang = getLang(Astro.currentLocale);
const es = {
  eyebrow: "NUESTRO IMPACTO",
  title: "EL IMPACTO DE NUESTRA MINERÍA FORMAL",
  text: "La minería formal genera beneficios que van más allá de la operación.",
  items: [
    {
      title: "GENERACIÓN DE EMPLEO SEGURO Y BIEN REMUNERADO",
      text: "Promueve empleos formales, condiciones laborales seguras y oportunidades de crecimiento para los trabajadores del sector minero.",
    },
    {
      title: "CONTRIBUCIÓN ECONÓMICA",
      text: "Genera ingresos para el país mediante impuestos y regalías, impulsando la economía y el desarrollo productivo.",
    },
    {
      title: "DESARROLLO SOCIAL",
      text: "Contribuye al bienestar de las comunidades mediante oportunidades laborales, colaboración local e iniciativas de desarrollo sostenible.",
    },
    {
      title: "INVERSIÓN EN INFRAESTRUCTURA COMUNITARIA",
      text: "Favorece el desarrollo de infraestructura y servicios que contribuyen a mejorar la conectividad y la calidad de vida de las comunidades.",
    },
  ],
};
const copy: Record<Lang, typeof es> = {
  es,
  en: {
    eyebrow: "OUR IMPACT",
    title: "THE IMPACT OF OUR FORMAL MINING",
    text: "Formal mining delivers benefits that go beyond the operation.",
    items: [
      {
        title: "CREATION OF SAFE, WELL-PAID JOBS",
        text: "Promotes formal employment, safe working conditions and growth opportunities for workers in the mining sector.",
      },
      {
        title: "ECONOMIC CONTRIBUTION",
        text: "Generates revenue for the country through taxes and royalties, boosting the economy and productive development.",
      },
      {
        title: "SOCIAL DEVELOPMENT",
        text: "Contributes to the well-being of communities through job opportunities, local collaboration and sustainable development initiatives.",
      },
      {
        title: "INVESTMENT IN COMMUNITY INFRASTRUCTURE",
        text: "Supports the development of infrastructure and services that help improve connectivity and quality of life in communities.",
      },
    ],
  },
};
const t = copy[lang];

// Íconos en el mismo orden que `items`; no dependen del idioma.
const icons = [
  // Casco de seguridad: trabajo protegido
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 15a7 7 0 0 1 5-6.7V5a1.5 1.5 0 0 1 3 0v3.3A7 7 0 0 1 18 15"/><rect x="3.5" y="15" width="17" height="2.6" rx="1.3"/><path d="M12 5v3.3"/></svg>`,
  // Gráfico en crecimiento: aporte económico
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/></svg>`,
  // Personas: comunidad y bienestar
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19c.6-3 2.8-4.5 5.5-4.5s4.9 1.5 5.5 4.5"/><circle cx="16.5" cy="9" r="2.6"/><path d="M15.8 14.6c2.7.2 4.1 1.6 4.7 4.4"/></svg>`,
  // Camino: conectividad e infraestructura
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 20L10 4M18 20L14 4"/><path d="M12 6.5v2M12 11v2M12 15.5v2"/></svg>`,
];
const impacts = t.items.map((item, i) => ({ ...item, icon: icons[i] }));
---
<section class="impact" aria-labelledby="impact-title">
  <div class="impact__head" data-reveal-stagger>
    <span class="team__eyebrow"><Eyebrow>{t.eyebrow}</Eyebrow></span>
    <h2 id="impact-title" class="title">{t.title}</h2>
    <p>{t.text}</p>
  </div>
  <ul class="impact__grid" data-reveal-stagger>
    {impacts.map((item) => (
      <li class="flip" tabindex="0" aria-label={`${item.title}: ${item.text}`}>
        <div class="flip__inner">
          <div class="flip__face flip__front" aria-hidden="true">
            <span class="flip__glyph" set:html={item.icon} />
            <span class="sr-only">{item.title}</span>
            <h3>{item.title}</h3>
          </div>
          <div class="flip__face flip__back" aria-hidden="true">
            <span class="flip__glyph flip__glyph--sm" set:html={item.icon} />
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>
<style>
  .impact {
    padding: 80px var(--pad-inline);
    background: var(--nb-white);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .impact__head {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .impact__head h2 {
    color: var(--nb-ink-800);
  }
  .impact__head p {
    font-size: 20px;
    line-height: 1.5;
    color: var(--nb-ink-700);
  }
  .impact__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .flip {
    perspective: 1200px;
    border-radius: 16px;
    outline-offset: 4px;
  }
  .flip__inner {
    position: relative;
    min-height: 320px;
    transform-style: preserve-3d;
    transition: transform 1000ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .flip__face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 32px 28px;
    border: 1.5px solid var(--nb-gold);
    border-radius: 16px;
    background: transparent;
    text-align: center;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .flip__back {
    transform: rotateY(180deg);
  }
  .flip__glyph {
    display: inline-flex;
    width: 88px;
    height: 88px;
    color: var(--nb-gold);
  }
  .flip__glyph svg {
    width: 100%;
    height: 100%;
  }
  .flip__glyph--sm {
    width: 40px;
    height: 40px;
  }
  .flip__face h3 {
    font: 700 22px / 1.15 var(--font-display);
    color: var(--nb-gold-ink);
  }
  .flip__back p {
    font-size: 15px;
    line-height: 1.55;
    color: var(--nb-gold-ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .flip:hover .flip__inner,
    .flip:focus-visible .flip__inner,
    .flip:focus-within .flip__inner {
      transform: rotateY(180deg);
    }
  }

  /* Sin hover (táctil): mostrar contenido estático sin giro. */
  @media (hover: none) {
    .flip__inner {
      transform: none;
      display: flex;
      flex-direction: column;
    }
    .flip__face {
      position: static;
      transform: none;
    }
    .flip__front {
      padding-bottom: 20px;
    }
    .flip__back {
      padding-top: 0;
    }
    .flip__front .flip__glyph {
      width: 56px;
      height: 56px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flip__inner {
      transition: none;
      transform: none;
      display: flex;
      flex-direction: column;
    }
    .flip__face {
      position: static;
      transform: none;
    }
    .flip__back {
      padding-top: 0;
    }
  }

  @media (max-width: 1100px) {
    .impact__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .flip__inner {
      min-height: 300px;
    }
  }
  @media (max-width: 760px) {
    .impact {
      padding: 48px 20px;
      gap: 32px;
    }
    .impact__head p {
      font-size: 16px;
    }
    .impact__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .flip__face h3 {
      font-size: 20px;
    }
  }
</style>
