---
import Icon from "./Icon.astro";
import { navigation, contact, socials, tagline } from "../data/site";
import logoUrl from "../assets/logo-nueva-bonanza.png?url";

const socialIcons = {
  Instagram: "instagram-outer",
  Facebook: "facebook",
  LinkedIn: "linkedin",
} as const;
---
<footer class="footer">
  <div>
    <a
      class="logo"
      href="/"
      aria-label="Nueva Bonanza Mining"
      style={`background-image:url(${logoUrl})`}
    ></a>
    <p class="footer__tag">{tagline}</p>
  </div>
  <nav aria-label="Pie">
    <h3>NAVEGACIÓN</h3>
    <ul>
      {
        navigation.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div>
    <h3>CONTACTO</h3>
    <ul>
      <li><Icon name="location" size={20} />{contact.address}</li>
      <li><Icon name="call" size={20} />{contact.phone}</li>
      <li><Icon name="mail" size={20} />{contact.email}</li>
      <li><Icon name="calendar" size={20} />{contact.hours}</li>
    </ul>
  </div>
  <div>
    <h3>REDES</h3>
    <div class="social">
      {
        socials.map((s) => (
          <a href={s.href} aria-label={s.label}>
            <Icon name={socialIcons[s.label as keyof typeof socialIcons]} size={17} />
          </a>
        ))
      }
    </div>
  </div>
</footer>
<style>
  .footer {
    padding: 48px;
    background: var(--nb-cream);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px 48px;
    color: #000;
  }
  .logo {
    display: block;
    width: 140px;
    height: 62px;
    background-position: 50% 50%;
    background-size: 100% 225%;
    background-repeat: no-repeat;
  }
  .footer h3 { font: 600 20px / 1 var(--font-display); margin-bottom: 18px; }
  .footer ul {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font: 500 16px / 1 var(--font-body);
  }
  .footer li { display: flex; align-items: center; gap: 10px; }
  .footer li .icon { color: var(--nb-gold); }
  .footer__tag { margin-top: 7px; font: 300 12px / 1.3 var(--font-body); }
  .social { display: flex; gap: 8px; }
  .social a {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-round);
    box-shadow: inset 0 0 0 1px #000;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
  }
  .social a:hover { box-shadow: inset 0 0 0 1px var(--nb-gold); }
  @media (max-width: 1100px) {
    .footer { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .footer { grid-template-columns: 1fr; padding: 40px 20px; gap: 32px; }
  }
</style>
