---
import Icon from "./Icon.astro";
import { navigation, contact, socials, tagline } from "../data/site";
import logoUrl from "../assets/img/logo-dorado.webp";

const socialIcons = {
  Instagram: "instagram-icon",
  Facebook: "facebook",
  LinkedIn: "linkedin",
} as const;

// El glifo de Instagram (Font Awesome, canvas 640) ocupa ~70 % de su
// caja frente al ~100 % de Facebook/LinkedIn: se compensa con más tamaño
// para igualar el tamaño óptico.
const socialSizes = {
  Instagram: 32,
  Facebook: 24,
  LinkedIn: 24,
} as const;
---

<footer class="footer">
  <div>
    <a
      class="logo"
      href="/"
      aria-label="Nueva Bonanza Mining"
      style={`background-image:url(${logoUrl.src})`}></a>
    <p class="footerTag">{tagline}</p>
  </div>
  <nav aria-label="Pie">
    <h3>NAVEGACIÓN</h3>
    <ul>
      {
        navigation.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div>
    <h3>CONTACTO</h3>
    <ul id="contacto-footer">
      <li><Icon name="location" size={20} color="var(--nb-gold)" />{contact.address}</li>
      <li><Icon name="call" size={20} color="var(--nb-gold)" /><a href={`tel:${contact.phone.replace(/\s/g, "")}`}>{contact.phone}</a></li>
      <li><Icon name="mail" size={20} color="var(--nb-gold)" /><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
      <li><Icon name="calendar" size={20} color="var(--nb-gold)" />{contact.hours}</li>
    </ul>
  </div>
  <div>
    <h3>REDES</h3>
    <div class="social">
      {
        socials.map((s) => (
          <a href={s.href} aria-label={s.label}>
            <Icon
              name={socialIcons[s.label as keyof typeof socialIcons]}
              size={socialSizes[s.label as keyof typeof socialSizes]}
            />
          </a>
        ))
      }
    </div>
  </div>
</footer>
<style>
  .footer {
    padding: 48px var(--pad-inline);
    background: var(--nb-ink-800);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px 48px;
    color: var(--nb-cream);
  }
  .footer > :last-child {
    justify-self: end;
  }
  .logo {
    display: block;
    width: 140px;
    height: 62px;
    background-position: 50% 50%;
    background-size: contain;
    background-repeat: no-repeat;
  }
  .footer h3 {
    font: 600 20px / 1 var(--font-display);
    margin-bottom: 18px;
    color: var(--nb-gold);
  }
  .footer ul {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font: 500 16px / 1.4 var(--font-body);
  }
  .footer li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .footer nav a {
    color: #fff;
    transition: color 0.2s;
  }
  .footer nav a:hover {
    color: var(--nb-gold);
  }
  .footerTag {
    margin-top: 7px;
    font: 500 16px / 1.3 var(--font-body);
    color: var(--nb-stone-2);
  }
  
  .social {
    display: flex;
    gap: 8px;
  }
  .social a {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-round);
    box-shadow: inset 0 0 0 1px var(--nb-umber);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--nb-cream);
    transition: color 0.2s, box-shadow 0.2s, background-color 0.2s;
  }
  .social a:hover {
    box-shadow: inset 0 0 0 1px var(--nb-gold);
    background-color: var(--nb-gold);
    color:#fff;
  }
  @media (max-width: 1100px) {
    .footer {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .footer > :last-child {
      justify-self: start;
    }
  }
  @media (max-width: 760px) {
    .footer {
      grid-template-columns: 1fr;
      padding: 40px 20px;
      gap: 32px;
    }
  }
</style>
