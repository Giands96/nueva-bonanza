---
import { getImage } from "astro:assets";
import { milestones, historyNote } from "../../data/about";
import Rule from "../Rule.astro";
import historyBg from "../../assets/img/hitos-plant.png";

// Fondo decorativo bajo overlay del 85%: basta una versión liviana.
const historyBgOpt = await getImage({
  src: historyBg,
  widths: [1200],
  formats: ["webp"],
  quality: 60,
});
---
<section class="history" aria-labelledby="history-title" style={`--history-bg:url(${historyBgOpt.src})`}>
  <div class="history__head" data-reveal-stagger>
    <b>NUESTROS HITOS</b>
    <h2 id="history-title">NUESTRA HISTORIA</h2>
  </div>
  <ol class="timeline" data-reveal-stagger style={`--count:${milestones.length}`}>
    {milestones.map((m, i) => (
      <li class="milestone" style={`--i:${i}`}>
        <i aria-hidden="true"></i>
        <b>{m.year}</b>
        <p>{m.text}</p>
      </li>
    ))}
  </ol>
  <div class="history__note" data-reveal>
    <Rule />
    <p>{historyNote}</p>
  </div>
</section>
<style>
  .history {
    position: relative;
    isolation: isolate;
    padding: clamp(80px, 10vw, 140px) var(--pad-inline);
    background: var(--nb-cream);
    display: flex;
    flex-direction: column;
    gap: 56px;
    overflow: hidden;
  }
  .history::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background: var(--history-bg) center / cover no-repeat;
    filter: grayscale(1) sepia(0.2);
  }
  .history::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(248, 246, 238, 0.85);
  }
  .history__head {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .history__head b {
    font: 500 24px / 1 var(--font-display);
    letter-spacing: 0.02em;
    color: var(--nb-gold-ink);
  }
  .history__head h2 {
    font: 700 56px / 1 var(--font-display);
    color: var(--nb-ink-800);
  }
  .timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--count,5), 1fr);
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline::before {
    content: "";
    position: absolute;
    top: 8px;
    left: calc(50% / var(--count, 5));
    right: calc(50% / var(--count, 5));
    height: 2px;
    background: var(--nb-gold);
  }
  .milestone {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }
  .milestone i {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--nb-gold);
  }
  .milestone b {
    font: 700 40px / 1 var(--font-display);
    color: var(--nb-ink-800);
  }
  .milestone p {
    font: 500 16px / 1.4 var(--font-body);
    color: var(--nb-ink-800);
  }
  /* Secuencia de aparición: primero se dibuja la línea y, al terminar, entran los hitos uno
     tras otro (el punto crece sobre la línea y el año y el texto suben). Reemplaza la cascada
     genérica de [data-reveal-stagger] de global.css. El total (1900ms con 5 hitos) queda por
     debajo de los 2600ms en que el script de BaseLayout quita el atributo. */
  @media screen and (prefers-reduced-motion: no-preference) {
    :global(html.js) .timeline[data-reveal-stagger]::before {
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 800ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    :global(html.js) .timeline[data-reveal-stagger].is-revealed::before {
      transform: none;
    }
    :global(html.js) .timeline[data-reveal-stagger] > .milestone {
      transform: none;
      transition: opacity 600ms cubic-bezier(0.2, 0.7, 0.2, 1);
      transition-delay: calc(700ms + var(--i, 0) * 150ms);
    }
    :global(html.js) .timeline[data-reveal-stagger] > .milestone > * {
      transition: transform 600ms cubic-bezier(0.2, 0.7, 0.2, 1);
      transition-delay: calc(700ms + var(--i, 0) * 150ms);
    }
    :global(html.js) .timeline[data-reveal-stagger] > .milestone > i {
      transform: scale(0.4);
    }
    :global(html.js) .timeline[data-reveal-stagger] > .milestone > :is(b, p) {
      transform: translateY(12px);
    }
    :global(html.js) .timeline[data-reveal-stagger].is-revealed > .milestone > * {
      transform: none;
    }
  }
  /* En una columna la línea es vertical: se dibuja de arriba hacia abajo. */
  @media screen and (prefers-reduced-motion: no-preference) and (max-width: 760px) {
    :global(html.js) .timeline[data-reveal-stagger]::before {
      transform: scaleY(0);
      transform-origin: center top;
    }
  }
  .history__note {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .history__note p {
    font: 400 18px / 1.5 var(--font-body);
    color: var(--nb-ink-800);
  }
  @media (max-width: 760px) {
    .history {
      padding: 56px 20px;
      gap: 36px;
    }
    .history__head h2 {
      font-size: 40px;
    }
    .history__head b {
      font-size: 20px;
    }
    .timeline {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-left: 40px;
    }
    .timeline::before {
      left: 8px;
      right: auto;
      top: 8px;
      bottom: 8px;
      width: 2px;
      height: auto;
    }
    .milestone {
      align-items: flex-start;
      text-align: left;
      gap: 8px;
    }
    .milestone i {
      position: absolute;
      left: -40px;
      top: 11px;
    }
    .milestone b {
      font-size: 36px;
    }
    .milestone p {
      max-width: none;
    }
    .history__note p {
      font-size: 16px;
    }
  }
</style>
