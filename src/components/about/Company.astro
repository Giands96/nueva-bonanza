---
import { Image } from "astro:assets";
import { getCompanyText } from "../../data/about";
import companyPhoto from "../../assets/img/comprometidos.webp";
import { getLang } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";

const lang = getLang(Astro.currentLocale);
const es = { kicker: "NUESTRA EMPRESA", photoAlt: "Equipo de topografía en campo" };
const copy: Record<Lang, typeof es> = {
  es,
  en: { kicker: "OUR COMPANY", photoAlt: "Surveying team in the field" },
};
const t = copy[lang];
const { companyHeading, companyText } = getCompanyText(lang);
---

<section class="company" aria-labelledby="company-title">
  <div class="company__text" data-reveal-stagger>
    <span class="company__kicker">{t.kicker}</span>
    <h2 id="company-title">{companyHeading}</h2>
    <p>{companyText}</p>
  </div>
  <div class="company__photo" data-reveal="image">
    <Image
      class="company__img"
      src={companyPhoto}
      alt={t.photoAlt}
      widths={[480, 800, 1200]}
      sizes="(max-width: 1100px) 100vw, 50vw"
      format="webp"
      quality={70}
      loading="lazy"
      decoding="async"
    />
  </div>
</section>
<style>
  .company {
    display: flex;
    height: 750px;
    background: #fff;
  }
  .company__text {
    flex: 1;
    padding: 48px var(--pad-inline);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
  }
  .company__kicker {
    font: 700 24px / 1 var(--font-display);
    color: var(--nb-gold-ink);
  }
  .company h2 {
    font: 700 64px / 1 var(--font-display);
    color: #000;
  }
  .company p {
    max-width: 620px;
    font-size: 20px;
    line-height: 1.5;
    color: #000;
  }
  .company__photo {
    position: relative;
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }
  .company__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .company__photo::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      270deg,
      rgba(0, 0, 0, 0) 0%,
      rgba(233, 231, 223, 0.25) 70%,
      #fff 98%
    );
  }
  @media (max-width: 1100px) {
    .company {
      flex-direction: column;
      height: auto;
    }
    .company__photo {
      flex: none;
      height: 420px;
    }
    .company__photo::before {
      background: linear-gradient(
        0deg,
        rgba(0, 0, 0, 0) 0%,
        rgba(233, 231, 223, 0.25) 74%,
        var(--nb-cream) 100%
      );
    }
  }
  @media (max-width: 760px) {
    .company__text {
      padding: 48px 20px;
    }
    .company h2 {
      font-size: 40px;
    }
    .company p {
      font-size: 16px;
    }
    .company__photo {
      height: 320px;
    }
  }
</style>
