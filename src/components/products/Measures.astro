---
import Rule from "../Rule.astro";
import { measures } from "../../data/products";
---
<section class="measures" aria-labelledby="measures-title">
  <div class="measures__head" data-reveal-stagger>
    <h2 id="measures-title" class="title">CÓMO LO HACEMOS</h2>
    <p>Cada etapa de la operación sigue las mismas prioridades.</p>
  </div>
  <ul class="measures__grid" data-reveal-stagger>
    {measures.map((m) => (
      <li>
        <Rule width={56} />
        <h3>{m.title}</h3>
        <p>{m.text}</p>
      </li>
    ))}
  </ul>
</section>
<style>
  .measures {
    padding: 80px var(--pad-inline);
    background: var(--nb-white);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .measures__head {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .measures__head h2 {
    color: var(--nb-ink-800);
  }
  .measures__head p {
    font-size: 20px;
    line-height: 1.5;
    color: var(--nb-ink-700);
  }
  .measures__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
  }
  .measures__grid li {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .measures__grid h3 {
    font: 700 28px / 1 var(--font-display);
    color: var(--nb-ink-800);
  }
  .measures__grid p {
    font-size: 16px;
    line-height: 1.55;
    color: var(--nb-ink-600);
  }
  @media (max-width: 1100px) {
    .measures__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 760px) {
    .measures {
      padding: 48px 20px;
      gap: 32px;
    }
    .measures__head p {
      font-size: 16px;
    }
    .measures__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .measures__grid h3 {
      font-size: 24px;
    }
  }
</style>
