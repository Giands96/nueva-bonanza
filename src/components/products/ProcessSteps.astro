---
import { getProcessSteps } from "../../data/products";
import { getLang } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";

const lang = getLang(Astro.currentLocale);
const es = {
  title: "DEL YACIMIENTO A LA COMERCIALIZACIÓN",
  text: "Desarrollamos nuestras operaciones mineras mediante procesos planificados, con énfasis en la seguridad, la eficiencia operativa y la gestión responsable de los recursos minerales.",
};
const copy: Record<Lang, typeof es> = {
  es,
  en: {
    title: "FROM DEPOSIT TO MARKET",
    text: "We carry out our mining operations through planned processes, with an emphasis on safety, operational efficiency and the responsible management of mineral resources.",
  },
};
const t = copy[lang];
const processSteps = getProcessSteps(lang);
---
<section class="process" aria-labelledby="process-title">
  <h2 id="process-title" class="title" data-reveal>{t.title}</h2>
  <p>{t.text}</p>
  <ol class="steps" data-reveal-stagger>
    {processSteps.map((s, i) => (
      <li class="step" style={`--i:${i}`}>
        <i aria-hidden="true"></i>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>
</section>
<style>
  .process {
    padding: 80px var(--pad-inline);
    background: var(--nb-cream);
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .process h2 {
    color: var(--nb-ink-800);
  }
  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px;
  }
  /* Línea entre el primer y el último punto (centro de la primera y última columna). */
  .steps::before {
    content: "";
    position: absolute;
    top: 8px;
    left: 10%;
    right: 10%;
    height: 2px;
    background: var(--nb-gold);
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }
  .step i {
    width: 18px;
    height: 18px;
    border-radius: var(--radius-round);
    background: var(--nb-gold);
  }
  .step h3 {
    font: 700 28px / 1 var(--font-display);
    text-transform: uppercase;
    color: var(--nb-ink-800);
  }
  .step p {
    max-width: 220px;
    font: 400 16px / 1.5 var(--font-body);
    color: var(--nb-ink-700);
  }
  /* Secuencia de aparición: primero se dibuja la línea y, al terminar, entran los pasos uno
     tras otro (el punto crece sobre la línea y el texto sube). Reemplaza la cascada genérica
     de [data-reveal-stagger] de global.css. El total (1900ms) queda por debajo de los 2600ms
     en que el script de BaseLayout quita el atributo. */
  @media screen and (prefers-reduced-motion: no-preference) {
    :global(html.js) .steps[data-reveal-stagger]::before {
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 800ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    :global(html.js) .steps[data-reveal-stagger].is-revealed::before {
      transform: none;
    }
    :global(html.js) .steps[data-reveal-stagger] > .step {
      transform: none;
      transition: opacity 600ms cubic-bezier(0.2, 0.7, 0.2, 1);
      transition-delay: calc(700ms + var(--i, 0) * 150ms);
    }
    :global(html.js) .steps[data-reveal-stagger] > .step > * {
      transition: transform 600ms cubic-bezier(0.2, 0.7, 0.2, 1);
      transition-delay: calc(700ms + var(--i, 0) * 150ms);
    }
    :global(html.js) .steps[data-reveal-stagger] > .step > i {
      transform: scale(0.4);
    }
    :global(html.js) .steps[data-reveal-stagger] > .step > :is(h3, p) {
      transform: translateY(12px);
    }
    :global(html.js) .steps[data-reveal-stagger].is-revealed > .step > * {
      transform: none;
    }
  }
  /* En una columna la línea es vertical: se dibuja de arriba hacia abajo. */
  @media screen and (prefers-reduced-motion: no-preference) and (max-width: 760px) {
    :global(html.js) .steps[data-reveal-stagger]::before {
      transform: scaleY(0);
      transform-origin: center top;
    }
  }
  @media (max-width: 1100px) {
    .step h3 {
      font-size: 22px;
    }
  }
  @media (max-width: 760px) {
    .process {
      padding: 48px 20px;
      gap: 32px;
    }
    .steps {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-left: 40px;
    }
    .steps::before {
      left: 8px;
      right: auto;
      top: 8px;
      bottom: 8px;
      width: 2px;
      height: auto;
    }
    .step {
      align-items: flex-start;
      text-align: left;
      gap: 8px;
    }
    .step i {
      position: absolute;
      left: -40px;
      top: 4px;
    }
    .step h3 {
      font-size: 24px;
    }
    .step p {
      max-width: none;
    }
  }
</style>
