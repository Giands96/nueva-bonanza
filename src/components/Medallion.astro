---
import Icon, { type IconName } from "./Icon.astro";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: cls } = Astro.props;
---
<span class:list={["medallion", cls]} aria-hidden="true">
  <Icon name={name} size={26} />
</span>
<style>
  .medallion {
    width: 58px;
    height: 58px;
    flex: none;
    border-radius: var(--radius-round);
    box-shadow: inset 0 0 0 1px var(--nb-gold);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--nb-gold);
  }
</style>
