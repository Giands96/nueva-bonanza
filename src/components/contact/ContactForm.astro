---
import Button from "../Button.astro";
import { contactReasons } from "../../data/site";
---

<form class="cform" id="contact-form" data-reveal novalidate>
  <div class="cform__intro">
    <h2>ENVÍENOS SU CONSULTA</h2>
    <p>
      Comparta los datos de su empresa y el motivo de contacto. Nuestro equipo
      evaluará su solicitud para derivarla al especialista correspondiente.
    </p>
    <small>Los campos marcados con * son obligatorios.</small>
  </div>
  <div class="fields">
    <label class="field">
      <span>Nombre y apellidos *</span>
      <input
        name="nombre"
        placeholder="Ej. María Salazar" 
        required
        autocomplete="name"
      />
    </label>
    <label class="field">
      <span>Empresa / organización *</span>
      <input
        name="empresa"
        placeholder="Nombre de la empresa"
        required
        autocomplete="organization"
      />
    </label>
    <label class="field">
      <span>Correo corporativo *</span>
      <input
        type="email"
        name="correo"
        placeholder="nombre@empresa.com"
        required
        autocomplete="email"
      />
    </label>
    <label class="field">
      <span>Teléfono *</span>
      <input
        type="tel"
        name="telefono"
        placeholder="+51 999 999 999"
        required
        autocomplete="tel"
      />
    </label>
    <label class="field">
      <span>Cargo</span>
      <input
        name="cargo"
        placeholder="Ej. Gerente de Operaciones"
        autocomplete="organization-title"
      />
    </label>
    <label class="field">
      <span>Motivo de contacto *</span>
      <select name="motivo" required>
        <option value="">Seleccione una opción</option>
        {
          contactReasons.map((r) => (
            <option value={r.label} data-to={r.to}>
              {r.label}
            </option>
          ))
        }
      </select>
    </label>
    <label class="field field--full">
      <span>Mensaje *</span>
      <textarea
        name="mensaje"
        placeholder="Cuéntenos sobre su proyecto, requerimiento, ubicación y plazo estimado."
        required></textarea>
    </label>
  </div>
  <label class="consent">
    <input type="checkbox" name="consentimiento" value="Sí" required />
    <span
      >He leído y acepto la Política de Privacidad y autorizo el tratamiento de
      mis datos para atender esta consulta. *</span
    >
  </label>
  <!-- Trampa anti-spam de FormSubmit: los humanos no la ven ni la rellenan. -->
  <input
    class="honey"
    type="text"
    name="_honey"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />
  <div class="cform__foot">
    <small
      >Sus datos serán tratados de forma confidencial y únicamente para atender
      esta solicitud.</small
    >
    <Button variant="solid" type="submit" icon="arrow-right"
      >Enviar consulta</Button
    >
  </div>
  <p class="cform__error" id="contact-error" role="alert" hidden>
    No pudimos enviar su consulta. Inténtelo nuevamente en unos minutos o
    escríbanos directamente a nuestro correo.
  </p>
</form>
<div class="thanks" id="contact-thanks" hidden>
  <span class="thanks__kicker">GRACIAS POR CONTACTARNOS</span>
  <h2>HEMOS RECIBIDO SU MENSAJE</h2>
  <p>
    Un especialista de Nueva Bonanza Mining revisará la información y se
    comunicará con usted.
  </p>
  <small>Tiempo estimado de respuesta: de 1 a 2 días hábiles.</small>
  <div class="ticket">
    <span>Código de seguimiento</span>
    <b id="ticket-code">NBM-000000-0000</b>
  </div>
  <div class="thanks__cta">
    <Button variant="solid" href="/">Volver al inicio</Button>
    <Button variant="outline-dark" href="/productos">Ver productos</Button>
  </div>
</div>
<script>
  // Envío con FormSubmit (https://formsubmit.co). El destinatario depende del
  // motivo elegido: cada <option> lleva su correo o alias en data-to (site.ts).
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const error = document.querySelector<HTMLElement>("#contact-error");

  const trackingCode = () => {
    const now = new Date();
    const stamp = `${String(now.getFullYear()).slice(2)}${String(now.getMonth() + 1).padStart(2, "0")}${String(now.getDate()).padStart(2, "0")}`;
    return `NBM-${stamp}-${Math.floor(1000 + Math.random() * 9000)}`;
  };

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;

    const motivo = form.querySelector<HTMLSelectElement>("[name=motivo]");
    const to = motivo?.selectedOptions[0]?.dataset.to;
    const submit = form.querySelector<HTMLButtonElement>("[type=submit]");
    if (!to || !submit) return;

    const data = Object.fromEntries(new FormData(form)) as Record<
      string,
      string
    >;
    // Un bot rellenó la trampa: se simula el éxito sin enviar nada.
    const isBot = Boolean(data._honey);
    delete data._honey;

    const code = trackingCode();
    const payload = {
      "Código de seguimiento": code,
      Motivo: data.motivo,
      Nombre: data.nombre,
      Empresa: data.empresa,
      Correo: data.correo,
      Teléfono: data.telefono,
      Cargo: data.cargo || "-",
      Mensaje: data.mensaje,
      Consentimiento: data.consentimiento,
      _subject: `[${code}] ${data.motivo} - ${data.empresa}`,
      _replyto: data.correo,
      _template: "table",
      _captcha: "false",
    };

    error?.setAttribute("hidden", "");
    submit.disabled = true;
    form.setAttribute("aria-busy", "true");
    try {
      if (!isBot) {
        const res = await fetch(
          `https://formsubmit.co/ajax/${encodeURIComponent(to)}`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify(payload),
          },
        );
        const json = await res.json().catch(() => ({}));
        if (!res.ok || String(json.success) !== "true")
          throw new Error(json.message ?? res.statusText);
      }
      const ticket = document.querySelector("#ticket-code");
      if (ticket) ticket.textContent = code;
      form.hidden = true;
      document.querySelector("#contact-thanks")?.removeAttribute("hidden");
      document.querySelector("#contact-urgent")?.removeAttribute("hidden");
    } catch (err) {
      console.error("[contacto] FormSubmit:", err);
      error?.removeAttribute("hidden");
    } finally {
      submit.disabled = false;
      form.removeAttribute("aria-busy");
    }
  });
</script>
<style>
  .cform {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .cform__intro {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cform h2 {
    font: 700 40px / 1 var(--font-display);
    color: var(--nb-ink-800);
  }
  .cform__intro p {
    font: 400 16px / 1.5 var(--font-body);
    color: var(--nb-ink-600);
  }
  .cform__intro small {
    font: 400 13px / 1 var(--font-body);
    color: var(--nb-taupe);
  }
  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .field--full {
    grid-column: 1 / -1;
  }
  .field span {
    font: 600 13px / 1 var(--font-body);
    color: var(--nb-ink-700);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    height: 52px;
    padding: 0 16px;
    border: 0;
    border-radius: 0;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--nb-stone);
    font: 400 14px / 1.4 var(--font-body);
    color: var(--nb-ink-700);
    outline: none;
  }
  .field textarea {
    height: 120px;
    padding: 16px;
    resize: none;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    box-shadow: inset 0 0 0 2px var(--nb-gold);
  }
  .consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font: 400 13px / 1.4 var(--font-body);
    color: var(--nb-ink-700);
    cursor: pointer;
  }
  .consent input {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--nb-gold);
  }
  .cform__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .cform__foot small {
    font: 400 12px / 1.4 var(--font-body);
    color: var(--nb-taupe);
  }
  .honey {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .cform :global(.btn:disabled) {
    opacity: 0.6;
    cursor: progress;
  }
  .cform__error {
    padding: 12px 16px;
    box-shadow: inset 0 0 0 1px var(--nb-umber);
    font: 400 14px / 1.4 var(--font-body);
    color: var(--nb-ink-800);
  }
  .cform__error[hidden] {
    display: none;
  }
  .thanks {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
  }
  .thanks[hidden],
  .cform[hidden] {
    display: none;
  }
  .thanks__kicker {
    font: 600 12px / 1 var(--font-body);
    letter-spacing: 0.08em;
    color: var(--nb-gold);
  }
  .thanks h2 {
    font: 700 48px / 1 var(--font-display);
    color: var(--nb-ink-800);
  }
  .thanks p {
    max-width: 640px;
    font: 400 20px / 1.45 var(--font-body);
    color: var(--nb-ink-700);
  }
  .thanks small {
    font: 400 14px / 1.4 var(--font-body);
    color: var(--nb-ink-600);
  }
  .ticket {
    align-self: flex-start;
    padding: 16px 20px;
    background: var(--nb-cream);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ticket span {
    font: 400 12px / 1 var(--font-body);
    color: var(--nb-taupe);
  }
  .ticket b {
    font: 600 24px / 1 var(--font-display);
    color: var(--nb-ink-800);
  }
  .thanks__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  @media (max-width: 760px) {
    .cform h2 {
      font-size: 32px;
    }
    .fields {
      grid-template-columns: 1fr;
    }
    .cform__foot {
      flex-direction: column;
      align-items: stretch;
    }
    .thanks h2 {
      font-size: 36px;
    }
    .thanks p {
      font-size: 18px;
    }
  }
</style>
