---
import Button from "../Button.astro";
import { contactReasons } from "../../data/site";
---

<form class="cform" id="contact-form" data-reveal novalidate>
  <div class="cform__intro">
    <h2>ENVÍENOS SU CONSULTA</h2>
    <p>
      Comparta los datos de su empresa y el motivo de contacto. Nuestro equipo
      evaluará su solicitud para derivarla al especialista correspondiente.
    </p>
    <small>Los campos marcados con * son obligatorios.</small>
  </div>
  <div class="fields">
    <label class="field">
      <span>Nombre y apellidos *</span>
      <input
        name="nombre"
        placeholder="Ej. María Salazar" 
        required
        autocomplete="name"
      />
    </label>
    <label class="field">
      <span>Empresa / organización *</span>
      <input
        name="empresa"
        placeholder="Nombre de la empresa"
        required
        autocomplete="organization"
      />
    </label>
    <label class="field">
      <span>Correo corporativo *</span>
      <input
        type="email"
        name="correo"
        placeholder="nombre@empresa.com"
        required
        autocomplete="email"
      />
    </label>
    <label class="field">
      <span>Teléfono *</span>
      <input
        type="tel"
        name="telefono"
        placeholder="+51 999 999 999"
        required
        autocomplete="tel"
      />
    </label>
    <label class="field">
      <span>Cargo</span>
      <input
        name="cargo"
        placeholder="Ej. Gerente de Operaciones"
        autocomplete="organization-title"
      />
    </label>
    <label class="field">
      <span>Motivo de contacto *</span>
      <select name="motivo" required>
        <option value="">Seleccione una opción</option>
        {
          contactReasons.map((r) => (
            <option value={r.label} data-to={r.to}>
              {r.label}
            </option>
          ))
        }
      </select>
    </label>
    <label class="field field--full">
      <span>Mensaje *</span>
      <textarea
        name="mensaje"
        placeholder="Cuéntenos sobre su proyecto, requerimiento, ubicación y plazo estimado."
        required></textarea>
    </label>
  </div>
  <label class="consent">
    <input type="checkbox" name="consentimiento" value="Sí" required />
    <span
      >Autorizo el tratamiento de mis datos para atender esta consulta. *</span
    >
  </label>
  <!-- Trampa anti-spam de FormSubmit: los humanos no la ven ni la rellenan. -->
  <input
    class="honey"
    type="text"
    name="_honey"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />
  <div class="cform__foot">
    <small
      >Sus datos serán tratados de forma confidencial y únicamente para atender
      esta solicitud.</small
    >
    <Button variant="solid" type="submit" icon="arrow-right"
      >Enviar consulta</Button
    >
  </div>
  <p class="cform__error" id="contact-error" role="alert" hidden>
    No pudimos enviar su consulta. Inténtelo nuevamente en unos minutos o
    escríbanos directamente a nuestro correo.
  </p>
</form>
<div class="thanks" id="contact-thanks" hidden>
  <span class="thanks__badge" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M5 12.5l4.5 4.5L19 7.5"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="thanks__check"
      />
    </svg>
  </span>
  <span class="thanks__kicker">Consulta registrada</span>
  <h2>Gracias por contactarnos</h2>
  <p>
    Hemos recibido su mensaje correctamente. Un especialista de Nueva Bonanza
    Mining revisará la información y se comunicará con usted.
  </p>
  <p class="thanks__eta">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8" />
      <path
        d="M12 7.5V12l3 2"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    <span
      ><strong>Tiempo estimado de respuesta:</strong> dentro de 1 a 2 días hábiles.</span
    >
  </p>
  <div class="thanks__cta">
    <Button variant="solid" href="/" icon="arrow-right">Volver al inicio</Button>
    <Button variant="outline-dark" href="/productos" icon="arrow-right"
      >Ver productos</Button
    >
  </div>
</div>
<script>
  // Envío con FormSubmit (https://formsubmit.co). El destinatario depende del
  // motivo elegido: cada <option> lleva su correo o alias en data-to (site.ts).
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const error = document.querySelector<HTMLElement>("#contact-error");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;

    const motivo = form.querySelector<HTMLSelectElement>("[name=motivo]");
    const to = motivo?.selectedOptions[0]?.dataset.to;
    const submit = form.querySelector<HTMLButtonElement>("[type=submit]");
    if (!to || !submit) return;

    const data = Object.fromEntries(new FormData(form)) as Record<
      string,
      string
    >;
    
    const isBot = Boolean(data._honey);
    delete data._honey;

    const payload = {
      Motivo: data.motivo,
      Nombre: data.nombre,
      Empresa: data.empresa,
      Correo: data.correo,
      Teléfono: data.telefono,
      Cargo: data.cargo || "-",
      Mensaje: data.mensaje,
      Consentimiento: data.consentimiento,
      _subject: `${data.motivo} - ${data.empresa}`,
      _replyto: data.correo,
      _template: "table",
      _captcha: "false",
    };

    error?.setAttribute("hidden", "");
    submit.disabled = true;
    form.setAttribute("aria-busy", "true");
    try {
      if (!isBot) {
        const res = await fetch(
          `https://formsubmit.co/ajax/${encodeURIComponent(to)}`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify(payload),
          },
        );
        const json = await res.json().catch(() => ({}));
        if (!res.ok || String(json.success) !== "true")
          throw new Error(json.message ?? res.statusText);
      }
      form.hidden = true;
      document.querySelector("#contact-thanks")?.removeAttribute("hidden");
      document.querySelector("#contact-urgent")?.removeAttribute("hidden");
    } catch (err) {
      console.error("[contacto] FormSubmit:", err);
      error?.removeAttribute("hidden");
    } finally {
      submit.disabled = false;
      form.removeAttribute("aria-busy");
    }
  });
</script>
<style>
  .cform {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .cform__intro {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cform h2 {
    font: 700 40px / 1 var(--font-display);
    color: var(--nb-ink-800);
  }
  .cform__intro p {
    font: 400 16px / 1.5 var(--font-body);
    color: var(--nb-ink-600);
  }
  .cform__intro small {
    font: 400 13px / 1 var(--font-body);
    color: var(--nb-taupe);
  }
  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .field--full {
    grid-column: 1 / -1;
  }
  .field span {
    font: 600 13px / 1 var(--font-body);
    color: var(--nb-ink-700);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    height: 52px;
    padding: 0 16px;
    border: 0;
    border-radius: 0;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--nb-stone);
    font: 400 14px / 1.4 var(--font-body);
    color: var(--nb-ink-700);
    outline: none;
  }
  .field textarea {
    height: 120px;
    padding: 16px;
    resize: none;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    box-shadow: inset 0 0 0 2px var(--nb-gold);
  }
  .consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font: 400 13px / 1.4 var(--font-body);
    color: var(--nb-ink-700);
    cursor: pointer;
  }
  .consent input {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--nb-gold);
  }
  .cform__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .cform__foot small {
    font: 400 12px / 1.4 var(--font-body);
    color: var(--nb-taupe);
  }
  .honey {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .cform :global(.btn:disabled) {
    opacity: 0.6;
    cursor: progress;
  }
  .cform__error {
    padding: 12px 16px;
    box-shadow: inset 0 0 0 1px var(--nb-umber);
    font: 400 14px / 1.4 var(--font-body);
    color: var(--nb-ink-800);
  }
  .cform__error[hidden] {
    display: none;
  }
  .thanks {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 16px;
    padding: 48px 40px;
    background: var(--nb-cream);
  }
  .thanks[hidden],
  .cform[hidden] {
    display: none;
  }
  .thanks:not([hidden]) {
    animation: thanks-in 350ms var(--ease-out) both;
  }
  .thanks:not([hidden]) .thanks__badge {
    animation: badge-pop 300ms var(--ease-out) 60ms both;
  }
  .thanks:not([hidden]) .thanks__check {
    stroke-dasharray: 24;
    stroke-dashoffset: 24;
    animation: check-draw 450ms var(--ease-out) 180ms forwards;
  }
  .thanks:not([hidden]) .thanks__kicker,
  .thanks:not([hidden]) h2,
  .thanks:not([hidden]) p,
  .thanks:not([hidden]) .thanks__cta {
    animation: thanks-rise 350ms var(--ease-out) both;
  }
  .thanks:not([hidden]) h2 {
    animation-delay: 90ms;
  }
  .thanks:not([hidden]) p {
    animation-delay: 140ms;
  }
  .thanks:not([hidden]) .thanks__eta {
    animation-delay: 190ms;
  }
  .thanks:not([hidden]) .thanks__cta {
    animation-delay: 230ms;
  }
  @keyframes thanks-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes thanks-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes badge-pop {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes check-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .thanks__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--nb-gold);
    color: var(--nb-ink-800);
  }
  .thanks__badge svg {
    width: 28px;
    height: 28px;
  }
  .thanks__kicker {
    font: 600 12px / 1 var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--nb-gold-ink);
  }
  .thanks h2 {
    font: 700 44px / 1.05 var(--font-display);
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--nb-ink-800);
  }
  .thanks p {
    max-width: 560px;
    font: 400 16px / 1.55 var(--font-body);
    color: var(--nb-ink-700);
  }
  .thanks__eta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    max-width: 560px;
    padding: 14px 18px;
    background: rgba(217, 166, 64, 0.16);
    font-size: 14px;
  }
  .thanks__eta svg {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--nb-gold-ink);
  }
  .thanks__eta strong {
    font-weight: 700;
  }
  .thanks__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 8px;
  }
  @media (prefers-reduced-motion: reduce) {
    .thanks:not([hidden]),
    .thanks:not([hidden]) .thanks__badge,
    .thanks:not([hidden]) .thanks__kicker,
    .thanks:not([hidden]) h2,
    .thanks:not([hidden]) p,
    .thanks:not([hidden]) .thanks__cta {
      animation: thanks-fade 200ms ease both;
    }
    .thanks:not([hidden]) .thanks__check {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
  @keyframes thanks-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @media (max-width: 760px) {
    .cform h2 {
      font-size: 32px;
    }
    .fields {
      grid-template-columns: 1fr;
    }
    .cform__foot {
      flex-direction: column;
      align-items: stretch;
    }
    .thanks {
      padding: 40px 20px;
    }
    .thanks__badge {
      width: 56px;
      height: 56px;
    }
    .thanks h2 {
      font-size: 34px;
    }
    .thanks p {
      font-size: 15px;
    }
    .thanks__eta {
      text-align: left;
    }
    .thanks__cta {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
  }
</style>
