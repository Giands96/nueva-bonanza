---
import { Image } from "astro:assets";
import Icon from "../Icon.astro";
import asideImg from "../../assets/img/hero-mine.png";
import { getContact } from "../../data/site";
import { getLang } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";

const lang = getLang(Astro.currentLocale);
const es = {
  imageAlt: "Operación minera Nueva Bonanza",
  kicker: "CONTACTO DIRECTO",
  text: "Nuestro equipo canalizará su consulta con el área correspondiente.",
  address: "DIRECCIÓN",
  phone: "TELÉFONO",
  email: "CORREO",
  hours: "HORARIO DE ATENCIÓN",
  urgentTitle: "¿SU CONSULTA ES URGENTE?",
  urgentText: (phone: string) => `Comuníquese al ${phone} durante nuestro horario de atención.`,
};
const copy: Record<Lang, typeof es> = {
  es,
  en: {
    imageAlt: "Nueva Bonanza mining operation",
    kicker: "DIRECT CONTACT",
    text: "Our team will route your inquiry to the appropriate department.",
    address: "ADDRESS",
    phone: "PHONE",
    email: "EMAIL",
    hours: "BUSINESS HOURS",
    urgentTitle: "IS YOUR INQUIRY URGENT?",
    urgentText: (phone) => `Call us at ${phone} during our business hours.`,
  },
};
const t = copy[lang];
const contact = getContact(lang);
---
<aside class="caside" data-reveal>
  <div class="caside__imgwrap">
    <Image
      class="caside__img"
      src={asideImg}
      alt={t.imageAlt}
      widths={[480, 800]}
      sizes="(max-width: 1100px) 100vw, 400px"
      formats={["webp"]}
      quality={70}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="caside__body">
    <div>
      <b class="caside__kicker">{t.kicker}</b>
      <p>{t.text}</p>
    </div>
    <dl>
      <div>
        <Icon name="location-lg" size={18} color="var(--nb-gold)" />
        <span><dt>{t.address}</dt><dd>{contact.address}</dd></span>
      </div>
      <div>
        <Icon name="call" size={18} color="var(--nb-gold)" />
        <span><dt>{t.phone}</dt><dd>{contact.phone}</dd></span>
      </div>
      <div>
        <Icon name="mail" size={18} color="var(--nb-gold)" />
        <span><dt>{t.email}</dt><dd>{contact.email}</dd></span>
      </div>
      <div>
        <Icon name="calendar" size={18} color="var(--nb-gold)" />
        <span><dt>{t.hours}</dt><dd>{contact.hours}</dd></span>
      </div>
    </dl>
    <div class="caside__urgent" id="contact-urgent" hidden>
      <b>{t.urgentTitle}</b>
      <span>{t.urgentText(contact.phone)}</span>
    </div>
  </div>
</aside>
<style>
  .caside {
    flex: 0 0 400px;
    align-self: flex-start;
    box-shadow: var(--shadow-aside);
  }
  .caside__imgwrap {
    position: relative;
    height: 208px;
    overflow: hidden;
  }
  .caside__imgwrap::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 42%, var(--nb-ink-800) 100%);
  }
  .caside__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .caside__body {
    padding: 32px;
    background: var(--nb-ink-800);
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .caside__kicker {
    display: block;
    margin-bottom: 8px;
    font: 600 12px / 1 var(--font-body);
    letter-spacing: 0.08em;
    color: var(--nb-gold);
  }
  .caside__body > div > p {
    font: 400 14px / 1.45 var(--font-body);
    color: var(--nb-stone-2);
  }
  .caside dl {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .caside dl > div {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .caside dt {
    font: 600 11px / 1 var(--font-body);
    letter-spacing: 0.08em;
    color: var(--nb-taupe);
    margin-bottom: 4px;
  }
  .caside dd {
    margin: 0;
    font: 500 16px / 1.3 var(--font-body);
    color: var(--nb-cream);
  }
  .caside__urgent {
    padding: 16px;
    box-shadow: inset 0 0 0 1px var(--nb-umber);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .caside__urgent[hidden] {
    display: none;
  }
  .caside__urgent b {
    font: 600 14px / 1 var(--font-display);
    color: var(--nb-gold);
  }
  .caside__urgent span {
    font: 400 13px / 1.4 var(--font-body);
    color: var(--nb-stone-2);
  }
  @media (max-width: 1100px) {
    .caside {
      flex: none;
      align-self: stretch;
    }
  }
  @media (max-width: 760px) {
    .caside__body {
      padding: 24px 20px;
    }
  }
</style>
