---
import Button from "../Button.astro";
---

<div class="thanks">
  <span class="thanks__badge" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M5 12.5l4.5 4.5L19 7.5"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="thanks__check"
      />
    </svg>
  </span>
  <span class="thanks__kicker">Consulta registrada</span>
  <h2>Gracias por contactarnos</h2>
  <p>
    Hemos recibido su mensaje correctamente. Un especialista de Nueva Bonanza
    Mining revisará la información y se comunicará con usted.
  </p>
  <p class="thanks__eta">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8" />
      <path
        d="M12 7.5V12l3 2"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    <span
      ><strong>Tiempo estimado de respuesta:</strong> dentro de 1 a 2 días hábiles.</span
    >
  </p>
  <div class="thanks__cta">
    <Button variant="solid" href="/" icon="arrow-right">Volver al inicio</Button>
    <Button variant="outline-dark" href="/productos" icon="arrow-right"
      >Ver productos</Button
    >
  </div>
</div>

<style>
  .thanks {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 16px;
    padding: 48px 40px;
    background: var(--nb-cream);
    animation: thanks-in 350ms var(--ease-out) both;
  }
  .thanks__badge {
    animation: badge-pop 300ms var(--ease-out) 60ms both;
  }
  .thanks__check {
    stroke-dasharray: 24;
    stroke-dashoffset: 24;
    animation: check-draw 450ms var(--ease-out) 180ms forwards;
  }
  .thanks__kicker,
  .thanks h2,
  .thanks p,
  .thanks__cta {
    animation: thanks-rise 350ms var(--ease-out) both;
  }
  .thanks h2 {
    animation-delay: 90ms;
  }
  .thanks p {
    animation-delay: 140ms;
  }
  .thanks__eta {
    animation-delay: 190ms;
  }
  .thanks__cta {
    animation-delay: 230ms;
  }
  @keyframes thanks-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes thanks-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes badge-pop {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes check-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .thanks__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--nb-gold);
    color: var(--nb-ink-800);
  }
  .thanks__badge svg {
    width: 28px;
    height: 28px;
  }
  .thanks__kicker {
    font: 600 12px / 1 var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--nb-gold-ink);
  }
  .thanks h2 {
    font: 700 44px / 1.05 var(--font-display);
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--nb-ink-800);
  }
  .thanks p {
    max-width: 560px;
    font: 400 16px / 1.55 var(--font-body);
    color: var(--nb-ink-700);
  }
  .thanks__eta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    max-width: 560px;
    padding: 14px 18px;
    background: rgba(217, 166, 64, 0.16);
    font-size: 14px;
  }
  .thanks__eta svg {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--nb-gold-ink);
  }
  .thanks__eta strong {
    font-weight: 700;
  }
  .thanks__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 8px;
  }
  @media (prefers-reduced-motion: reduce) {
    .thanks,
    .thanks__badge,
    .thanks__kicker,
    .thanks h2,
    .thanks p,
    .thanks__cta {
      animation: thanks-fade 200ms ease both;
    }
    .thanks__check {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
  @keyframes thanks-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @media (max-width: 760px) {
    .thanks {
      padding: 40px 20px;
    }
    .thanks__badge {
      width: 56px;
      height: 56px;
    }
    .thanks h2 {
      font-size: 34px;
    }
    .thanks p {
      font-size: 15px;
    }
    .thanks__eta {
      text-align: left;
    }
    .thanks__cta {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
  }
</style>
