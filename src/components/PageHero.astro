---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow: string;
  title: string;
  text: string | string[];
  image: ImageMetadata;
  filled?: boolean;
  compact?: boolean;
  tall?: boolean;
  eyebrowColor?: string;
}

const { eyebrow, title, text, image, filled = true, compact = false, tall = false, eyebrowColor } = Astro.props;
---
<section class:list={["phero", compact && "phero--compact", tall && "phero--tall"]}>
  <Image
    class="phero__bg"
    src={image}
    alt=""
    aria-hidden="true"
    widths={[768, 1280, 1920]}
    sizes="100vw"
    format="webp"
    quality={75}
    loading="eager"
    fetchpriority="high"
  />
  <div class:list={["phero__content", Array.isArray(text) && "phero__content--long"]}>
    <Eyebrow filled={filled} color={eyebrowColor}>{eyebrow}</Eyebrow>
    <h1>{title}</h1>
    {Array.isArray(text)
      ? text.map((paragraph) => <p>{paragraph}</p>)
      : <p>{text}</p>}
  </div>
</section>
<style>
  .phero {
    position: relative;
    min-height: 670px;
    padding: 48px var(--pad-inline);
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--nb-ink-800);
  }

  .phero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .phero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, 0.5);
  }
  .phero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    max-width: 640px;
    color: #fff;
    animation: phero-in 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes phero-in {
    from { opacity: 0; transform: translateY(28px); }
    to { opacity: 1; transform: none; }
  }
  .phero h1 {
    font: 700 96px / 1 var(--font-display);
  }
  .phero p {
    font-size: 20px;
    line-height: 1.4;
  }
  .phero__content--long {
    gap: 20px;
    max-width: 680px;
  }
  .phero__content--long p {
    font-size: 18px;
    line-height: 1.6;
  }
  .phero--compact::before {
    background: linear-gradient(90deg, rgba(21, 18, 15, 0.85) 0%, rgba(21, 18, 15, 0.45) 65%, rgba(21, 18, 15, 0.2) 100%);
  }
  .phero--compact h1 {
    font-size: 64px;
  }
  .phero--compact p {
    font: 400 20px / 1.45 var(--font-body);
    color: var(--nb-cream-2);
    max-width: 610px;
  }
  @media (max-width: 1100px) {
    .phero h1 {
      font-size: 72px;
    }
  }
  @media (max-width: 760px) {
    .phero {
      min-height: 420px;
      padding: 48px 20px 40px;
      align-items: flex-end;
    }
    .phero--compact {
      min-height: 440px;
    }
    .phero--compact h1 {
      font-size: 40px;
    }
    .phero h1 {
      font-size: 56px;
    }
    .phero p {
      font-size: 16px;
    }
  }
</style>
