---
import type { ImageMetadata } from "astro";
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow: string;
  title: string;
  text: string;
  image: ImageMetadata;
  filled?: boolean;
  compact?: boolean;
  eyebrowColor?: string;
}

const { eyebrow, title, text, image, filled = true, compact = false, eyebrowColor } = Astro.props;
---
<section class:list={["phero", compact && "phero--compact"]} style={`background-image:url(${image.src})`}>
  <div class="phero__content">
    <Eyebrow filled={filled} color={eyebrowColor}>{eyebrow}</Eyebrow>
    <h1>{title}</h1>
    <p>{text}</p>
  </div>
</section>
<style>
  .phero {
    position: relative;
    height: 500px;
    padding: 0 var(--pad-inline);
    display: flex;
    align-items: center;
    background-color: var(--nb-ink-800);
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
  }
  .phero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }
  .phero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    max-width: 640px;
    color: #fff;
    /* Misma entrada que el hero de Inicio (HeroHome). */
    animation: phero-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes phero-in {
    from { opacity: 0; transform: translateY(28px); }
    to { opacity: 1; transform: none; }
  }
  .phero h1 {
    font: 700 96px / 1 var(--font-display);
  }
  .phero p {
    font-size: 20px;
    line-height: 1.4;
  }
  .phero--compact::before {
    background: linear-gradient(90deg, rgba(21, 18, 15, 0.85) 0%, rgba(21, 18, 15, 0.45) 65%, rgba(21, 18, 15, 0.2) 100%);
  }
  .phero--compact h1 {
    font-size: 64px;
  }
  .phero--compact p {
    font: 400 18px / 1.45 var(--font-body);
    color: var(--nb-cream-2);
    max-width: 610px;
  }
  @media (max-width: 1100px) {
    .phero h1 {
      font-size: 72px;
    }
  }
  @media (max-width: 760px) {
    .phero {
      height: 420px;
      padding: 0 20px 40px;
      align-items: flex-end;
    }
    .phero--compact {
      height: 440px;
    }
    .phero--compact h1 {
      font-size: 40px;
    }
    .phero h1 {
      font-size: 56px;
    }
    .phero p {
      font-size: 16px;
    }
  }
</style>
