---
export type IconName =
  | "arrow-right"
  | "arrow-back"
  | "arrow-forward"
  | "location"
  | "location-lg"
  | "call"
  | "mail"
  | "calendar"
  | "instagram-icon"
  | "facebook"
  | "linkedin";

interface Props {
  name: IconName;
  size?: number;
  color?: string;
  class?: string;
}

const { name, size = 24, color, class: cls } = Astro.props;

const icons = import.meta.glob<string>("../assets/icons/*.svg", {
  query: "?url",
  import: "default",
  eager: true,
});
const url = icons[`../assets/icons/${name}.svg`];
---
<span
  class:list={["icon", cls]}
  style={`--i:url(${url});width:${size}px;height:${size}px${color ? `;color:${color}` : ""}`}
  aria-hidden="true"
></span>

