---
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import SedesMap from "./contact/SedesMap.astro";
import { contact } from "../data/site";
---
<section class="contact" aria-labelledby="contact-title">
  <div class="contact__head" data-reveal-stagger>
    <h2 id="contact-title">CONTÁCTANOS</h2>
    <p>
      Conversemos sobre nuestra operación y el futuro de una minería
      responsable en el Perú.
    </p>
    <Button variant="solid" href="/contacto">Escríbenos</Button>
  </div>
  <SedesMap>
    <dl class="contact__extra">
      <div>
        <dt><Icon name="mail" size={18} color="var(--nb-gold)" />Correo</dt>
        <dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
      </div>
      <div>
        <dt><Icon name="calendar" size={18} color="var(--nb-gold)" />Horario de atención</dt>
        <dd>{contact.hours}</dd>
      </div>
    </dl>
  </SedesMap>
</section>
<style>
  .contact {
    padding: 72px var(--pad-inline);
    background: var(--nb-ink-800);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .contact__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .contact__head h2 { font: 500 64px / 1 var(--font-display); color: var(--nb-cream); }
  .contact__head p {
    font: 400 20px / 1.55 var(--font-body);
    color: var(--nb-stone-2);
    margin-bottom: 12px;
  }
  .contact__extra {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 48px;
    padding-top: 32px;
    border-top: 1px solid rgba(210, 206, 198, 0.25);
  }
  .contact__extra dt {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    font: 600 14px / 1 var(--font-body);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--nb-stone-2);
  }
  .contact__extra dd {
    margin: 0;
    font: 400 16px / 1.5 var(--font-body);
    color: var(--nb-cream);
  }
  .contact__extra a:hover {
    color: var(--nb-gold);
  }
  @media (max-width: 760px) {
    .contact { padding: 48px 20px; gap: 32px; }
    .contact__head h2 { font-size: 44px; }
    .contact__head p { font-size: 16px; }
  }
</style>
