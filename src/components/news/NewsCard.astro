---
import Icon from "../Icon.astro";
import placeholder from "../../assets/img/news-1.png";
import type { NewsItem } from "../../lib/wordpress";

interface Props {
  item: NewsItem;
}

const { item } = Astro.props;
const image = item.image ?? { src: placeholder.src, alt: "", width: placeholder.width, height: placeholder.height };
---
<a class="article" href={`/noticias/${item.slug}`}>
  <img
    class="article__img"
    src={image.src}
    srcset={image.srcSet}
    sizes="(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 33vw"
    width={image.width}
    height={image.height}
    alt={image.alt}
    loading="lazy"
    decoding="async"
  />
  <time datetime={item.date}>{item.dateLabel}</time>
  <h3>{item.title}</h3>
  <span class="article__more">LEER MÁS<Icon name="arrow-right" size={16} /></span>
</a>
<style>
  .article {
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: var(--nb-ink-700);
  }
  .article__img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    background: var(--nb-sand);
  }
  .article time {
    font: 500 14px / 1 var(--font-body);
    color: var(--nb-taupe);
  }
  .article h3 {
    font: 600 24px / 1.15 var(--font-display);
    color: var(--nb-ink-800);
    text-transform: uppercase;
    transition: color 0.2s ease;
  }
  .article:hover h3 {
    color: var(--nb-gold);
  }
  .article__more {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 600 14px / 1 var(--font-body);
    letter-spacing: var(--ls-button);
    color: var(--nb-ink-800);
  }
  .article__more :global(.icon) {
    color: var(--nb-gold);
    transition: transform 0.2s ease;
  }
  .article:hover .article__more :global(.icon) {
    transform: translateX(4px);
  }
  @media (max-width: 760px) {
    .article__img {
      height: 220px;
    }
  }
</style>
