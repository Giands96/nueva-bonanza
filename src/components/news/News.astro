---
import type { Page } from "astro";
import Icon from "../Icon.astro";
import type { NewsItem } from "../../lib/wordpress";
import placeholder from "../../assets/img/news-1.png";
import arrowRightUrl from "../../assets/icons/arrow-right.svg?url";

interface Props {
  page: Page<NewsItem>;
}

const { page } = Astro.props;
// La grilla se dibuja en el navegador contra WordPress (ver `news-hydrate.ts`):
// el build no guarda noticias, solo el cascarón con el loader.
const prevHref = page.currentPage > 1 ? (page.currentPage === 2 ? "/noticias" : `/noticias/${page.currentPage - 1}`) : null;
const nextHref = page.currentPage < page.lastPage ? `/noticias/${page.currentPage + 1}` : null;
---
<section
  class="news"
  aria-labelledby="news-title"
  data-news-list
  data-page={page.currentPage}
  data-last-page={page.lastPage}
  data-placeholder={placeholder.src}
  data-icon-arrow={arrowRightUrl}
>
  <h2 id="news-title">ÚLTIMAS NOTICIAS</h2>
  <div class="news__loading" data-loading role="status">
    <span class="news__spinner" aria-hidden="true"></span>
    <p>Cargando noticias…</p>
  </div>
  <ul class="news__grid" data-grid data-reveal-stagger hidden></ul>
  <p class="news__empty" data-empty hidden>No hay noticias publicadas por ahora.</p>
  <p class="news__error" data-error hidden>No pudimos cargar las noticias. Inténtelo nuevamente en unos minutos.</p>
  <noscript><p class="news__empty">Active JavaScript para ver las noticias.</p></noscript>
  <nav class="pager" data-pager aria-label="Paginación de noticias" hidden>
    {prevHref ? (
      <a data-prev href={prevHref} rel="prev">
        <span class="icon--flip"><Icon name="arrow-back" size={16} /></span>Atrás
      </a>
    ) : <span data-prev-hidden />}
    <span class="pager__count" data-count>{page.currentPage} / {page.lastPage}</span>
    {nextHref ? (
      <a data-next href={nextHref} rel="next">
        Siguiente<Icon name="arrow-forward" size={16} />
      </a>
    ) : <span data-next-hidden />}
  </nav>
</section>
<style>
  .news {
    padding: 72px var(--pad-inline);
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .news h2 {
    font: 700 48px / 1 var(--font-display);
    color: #000;
  }
  .news__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .news__empty {
    font: 400 18px / 1.55 var(--font-body);
    color: var(--nb-ink-600);
  }
  .news__error {
    font: 400 18px / 1.55 var(--font-body);
    color: var(--nb-ink-600);
  }
  /* `display:grid` del grid pisaría el `hidden` nativo: se fuerza acá. */
  .news__grid[hidden],
  .news__empty[hidden],
  .news__error[hidden],
  .news__loading[hidden],
  .pager[hidden],
  .pager a[hidden] {
    display: none;
  }
  .news__loading {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 48px 0;
    font: 400 18px / 1.55 var(--font-body);
    color: var(--nb-taupe);
  }
  .news__spinner {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 3px solid var(--nb-sand);
    border-top-color: var(--nb-gold);
    animation: news-spin 0.8s linear infinite;
  }
  @keyframes news-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .news__spinner {
      animation: none;
      border-top-color: var(--nb-sand);
    }
  }
  /* Mismo estilo que los controles ATRÁS / SIGUIENTE del carrusel de Inicio. */
  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .pager a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    min-height: 44px;
    font: 600 14px / 1 var(--font-body);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--nb-ink-800);
    transition: color 0.2s ease;
  }
  .pager a:hover {
    color: var(--nb-gold);
  }
  .pager :global(.icon) {
    color: var(--nb-gold);
  }
  .pager__count {
    font: 500 14px / 1 var(--font-body);
    color: var(--nb-taupe);
  }
  .icon--flip {
    display: inline-flex;
    transform: scaleX(-1);
  }
  @media (max-width: 1100px) {
    .news__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .news {
      padding: 48px 20px;
    }
    .news h2 {
      font-size: 36px;
    }
    .news__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .pager a {
      padding: 12px 0;
    }
  }
</style>
