# Página 404 personalizada (generada como /404.html por Astro).
ErrorDocument 404 /404.html

# Una sola versión del sitio, la misma que declara el canonical:
# https://nbonanzamining.com (sin www). Evita que Google vea duplicados.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www -> dominio sin www.
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://nbonanzamining.com%{REQUEST_URI} [R=301,L]

  # http -> https. X-Forwarded-Proto cubre el caso de un proxy que termina el
  # TLS antes de Apache (sin esa condición, la regla entraría en bucle).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://nbonanzamining.com%{REQUEST_URI} [R=301,L]

  # /carpeta/index.html pedido explícitamente -> /carpeta/. THE_REQUEST mira
  # la petición original, así no choca con el DirectoryIndex interno.
  RewriteCond %{THE_REQUEST} \s/(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>

# Caché larga para assets versionados por Astro (nombres con hash único).
# Solo aplica en hostings Apache (Ferozo). Si el servidor lo ignora, no afecta.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
# Cabeceras de seguridad básicas.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Bloquea archivos ocultos (.env, .git, etc.) si alguno llegara a subirse.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|avif|png|jpe?g|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # JS/CSS con hash de Astro (ej. index.DLzImNLg.css). ExpiresByType no los
  # cubre si Apache los sirve como text/javascript.
  <FilesMatch "\.[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
